label: p.label, badge: { id: \"cell\", text: \"\" }, items: [","     { buttons: p.cases.map((c, i) => ({ id: c.id, label: c.label, pressed: i === 0, onClick: () => { kase = i; p.cases.forEach((k, j) => ui.toggle(k.id).set(j === i)); t = 0; draw(); } })) },","     { slider: { id: \"speed\", label: \"Impact speed (km/h)\", min: p.speed.min, max: p.speed.max, step: 5, value: kmh, onInput: v => { kmh = v; run(); t = 0; } } },"]},{"oldStart":83,"oldLines":7,"newStart":84,"newLines":8,"lines":["     const s = sims[kase], zone = p.cases[kase].zone, v0 = kmh / 3.6, gap = v0 / p.slow * APPROACH;","     const tau = Math.max(0, (t - APPROACH) / p.slow), done = tau >= s.duration;","     const d = t < APPROACH ? 0 : done ? s.crush : sample(s, tau, \"x\"), g = t < APPROACH || done ? 0 : sample(s, tau, \"a\");","-    car.position.x = t < APPROACH ? -gap + v0 / p.slow * t : d;","+    // Over the museum photo the car stays where it stands and the front folds back towards the cell instead.","+    car.position.x = onPhoto ? 0 : t < APPROACH ? -gap + v0 / p.slow * t : d;","     // The front folds ring by ring from the bumper (which sits on the wall at car-frame x = xb − d); whatever crush is","     // left over once the zone is used up pushes the firewall into the cell.","     const front = Math.min(d, zone.length), intr = d - front;"]},{"oldStart":104,"oldLines":7,"newStart":106,"newLines":7,"lines":["   pose();"," ","   return {","-    layout({ active }) { group.visible = active; },","+    layout({ active, onPhoto: photo }) { group.visible = active; onPhoto = photo; wall.visible = !photo; tyreMat.opacity = photo ? 0.12 : 1; pose(); },","     update(dt) {","       if (playing) { t += dt; if (t > APPROACH + sims[kase].duration * p.slow + HOLD) t = 0; }","       pose();"]}]}],"moreFiles":0,"changedFiles":["/Users/kunabel/workspace/MercedesExperience/subsystems/crumple-zone.js"]}},"serverClassifierContext":{"request":"136aab54-631c-4b33-ac33-26334919b116","context":{"git_state":{"cwd":"/