* (CX[k] * U) ** 2 - uu));\n240\t  for (let c = 0; c < N; c++) { f.set(inflow, 9 * c); if (solid[c]) ux[c] = 0; }\n241\t  const fe = new Float64Array(9), fo = new Float64Array(9);\n242\t  // Drag on the body this step (lattice force units, + = downstream): total by momentum exchange at the walls; the pressure\n243\t  // part split into push on upstream-facing faces and suction on downstream-facing ones; friction is the rest.\n244\t  const drag = { total: 0, push: 0, suction: 0, friction: 0 };\n245\t\n246\t  function step() {\n247\t    let fx = 0, rf = 0, nf = 0, rr = 0, nr = 0;\n248\t    for (let j = 0; j < nz; j++) for (let i = 0; i < nx; i++) {\n249\t      const c = j * nx + i; if (solid[c]) continue;\n250\t      const o = 9 * c;\n251\t      let r = 0, mx = 0, mz = 0;\n252\t      for (let k = 0; k < 9; k++) { const v = f[o + k]; r += v; mx += CX[k] * v; mz += CZ[k] * v; }\n253\t      const u = mx / r, w = mz / r, q = 1.5 * (u * u + w * w);\n254\t      rho[c] = r; ux[c] = u; uz[c] = w;\n255\t      let pxx = 0, pzz = 0, pxz = 0;\n256\t      for (let k = 0; k < 9; k++) {\n257\t        const cu = 3 * (CX[k] * u + CZ[k] * w), e = W[k] * r * (1 + cu + 0.5 * cu * cu - q), d = f[o + k] - e;\n258\t        fe[k] = e; fo[k] = d; pxx += CX[k] * CX[k] * d; pzz += CZ[k] * CZ[k] * d; pxz += CX[k] * CZ[k] * d;\n259\t      }\n260\t      // Smagorinsky: the local strain (from the non-equilibrium stress) raises the relaxation time where the flow shears.\n261\t      const tau = 0.5 * (tau0 + Math.sqrt(tau0 * tau0 + C * Math.sqrt(pxx * pxx + pzz * pzz + 2 * pxz * pxz) / r)), om = 1 / tau;\n262\t      for (let k = 0; k < 9; k++) {\n263\t        const v = fe[k] + (1 - om) * fo[k], ti = i + CX[k], tj = j + CZ[k];\n264\t        if (tj < 0) g[o + OPP[k]] = v - 6 * W[k] * r * CX[k] * U;                       // road moving at U\n265\t        else if (tj >= nz) { if (ti >= 0 && ti < nx) g[9 * (j * nx + ti) + MIRROR_Z[k]] = v; }   // free-slip top\n266\t        else if (ti < 0 || ti >= nx) co