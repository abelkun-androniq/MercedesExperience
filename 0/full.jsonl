{"parentUuid":"161fdc47-fd05-4026-8180-ba03b1ab7e11","isSidechain":false,"promptId":"520f657a-52b6-42e2-ac69-925bae4d884a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QiXmAMaKFhASEsup1Agfjs","type":"tool_result","content":"1\t// Geometry helpers shared by all subsystems. Scene units are metres; hardpoints are mm in the vehicle frame (x fwd, y left, z up).\n2\timport * as THREE from \"three\";\n3\t\n4\texport const V = (x, y, z) => new THREE.Vector3(x, y, z);\n5\texport const mm = v => V(v[0] / 1000, v[1] / 1000, v[2] / 1000);\n6\texport const Y = V(0, 1, 0);\n7\tconst cylGeo = new THREE.CylinderGeometry(1, 1, 1, 16), sphGeo = new THREE.SphereGeometry(1, 16, 12);\n8\t\n9\texport const mat = (c = 0xffffff, o = {}) => new THREE.MeshStandardMaterial({ color: c, roughness: 0.5, metalness: 0.15, ...o });\n10\texport const glass = (c = 0x8fa3b3, opacity = 0.12) => new THREE.MeshStandardMaterial({ color: c, transparent: true, opacity, depthWrite: false, side: THREE.DoubleSide });\n11\texport const line = (c = 0x8fa3b3, opacity = 0.6) => new THREE.LineBasicMaterial({ color: c, transparent: true, opacity });\n12\t\n13\t// Unit cylinder stretched between two points by place(); r = radius (m).\n14\texport function rod(m, r) { const o = new THREE.Mesh(cylGeo, m); o.userData.r = r; return o; }\n15\texport function place(o, a, b) {\n16\t  const d = new THREE.Vector3().subVectors(b, a), len = d.length();\n17\t  o.position.copy(a).addScaledVector(d, 0.5);\n18\t  if (len > 1e-9) o.quaternion.setFromUnitVectors(Y, d.multiplyScalar(1 / len));\n19\t  o.scale.set(o.userData.r, Math.max(len, 1e-6), o.userData.r);\n20\t  return o;\n21\t}\n22\texport function ball(m, r, p) { const o = new THREE.Mesh(sphGeo, m); o.scale.setScalar(r); if (p) o.position.copy(p); return o; }\n23\t\n24\t// Coil spring between a and b.\n25\texport function helix(a, b, turns = 7, r = 0.046, wire = 0.007) {\n26\t  const d = new THREE.Vector3().subVectors(b, a), len = d.length(), n = d.clone().normalize();\n27\t  const t1 = V(1, 0, 0).cross(n).normalize(), t2 = n.clone().cross(t1), pts = [];\n28\t  for (let i = 0; i <= 200; i++) {\n29\t    const u = i / 200, th = u * Math.PI * 2 * turns;\n30\t    pts.push(a.clone().addScaledVector(n, u * len).addScaledVector(t1, Math.cos(th) * r).addScaledVector(t2, Math.sin(th) * r));\n31\t  }\n32\t  return new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts), 200, wire, 6, false);\n33\t}\n34\t\n35\t// Tyre (torus) with its axis along y. R = ring radius, r = section radius (m).\n36\texport function tyre(m, R = 0.235, r = 0.057) {\n37\t  const g = new THREE.Group();\n38\t  const t = new THREE.Mesh(new THREE.TorusGeometry(R, r, 14, 56), m); t.rotation.x = Math.PI / 2; g.add(t);\n39\t  return g;\n40\t}\n41\t\n42\t// Tyre on a wire wheel, axis along y. spokeMat is a LineBasicMaterial; spokeMat.userData.solid is the rim material.\n43\texport function wireWheel(tyreMat, spokeMat, R = 0.295, r = 0.085, spokeR = 0.215, spokes = 32) {\n44\t  const g = tyre(tyreMat, R, r);\n45\t  if (spokeMat) {\n46\t    const pts = [];\n47\t    for (let i = 0; i < spokes; i++) {\n48\t      const a = i / spokes * Math.PI * 2, side = i % 2 ? 0.035 : -0.035;\n49\t      pts.push(0, side, 0, spokeR * Math.cos(a), 0, spokeR * Math.sin(a));\n50\t    }\n51\t    const sg = new THREE.BufferGeometry(); sg.setAttribute(\"position\", new THREE.Float32BufferAttribute(pts, 3));\n52\t    g.add(new THREE.LineSegments(sg, spokeMat));\n53\t    const rim = new THREE.Mesh(new THREE.TorusGeometry(spokeR, 0.008, 6, 48), spokeMat.userData.solid); rim.rotation.x = Math.PI / 2; g.add(rim);\n54\t  }\n55\t  return g;\n56\t}\n57\t\n58\t// Wooden artillery-style wheel (spokes as rods), axis along y.\n59\texport function spokedWheel(tyreMat, spokeMat, R = 0.42, spokes = 12) {\n60\t  const g = tyre(tyreMat, R, 0.022);\n61\t  for (let i = 0; i < spokes; i++) { const a = i / spokes * Math.PI * 2; g.add(place(rod(spokeMat, 0.012), V(0, 0, 0), V(R * Math.cos(a), 0, R * Math.sin(a)))); }\n62\t  g.add(place(rod(spokeMat, 0.05), V(0, -0.06, 0), V(0, 0.06, 0)));\n63\t  return g;\n64\t}\n65\t\n66\texport function edgesOf(geo, group, fillMat, lineMat, thresh = 22) {\n67\t  group.add(new THREE.Mesh(geo, fillMat), new THREE.LineSegments(new THREE.EdgesGeometry(geo, thresh), lineMat));\n68\t}\n69\t\n70\t// Points along an arc in a 2-D profile (mm, degrees).\n71\texport const arc = (cx, cz, r, a0, a1, n = 14) => Array.from({ length: n + 1 }, (_, i) => {\n72\t  const a = (a0 + (a1 - a0) * i / n) * Math.PI / 180; return [cx + r * Math.cos(a), cz + r * Math.sin(a)];\n73\t});\n74\t\n75\t// Side-profile polygon (x, z in mm) extruded across y from y0 to y1 (mm). Entries may be { arc: [cx, cz, r, a0, a1, n] }.\n76\texport function profileExtrude(pts, y0, y1) {\n77\t  const flat = pts.flatMap(p => (p.arc ? arc(...p.arc) : [p]));\n78\t  const s = new THREE.Shape(); s.moveTo(flat[0][0], flat[0][1]); for (const p of flat.slice(1)) s.lineTo(p[0], p[1]);\n79\t  const g = new THREE.ExtrudeGeometry(s, { depth: y1 - y0, bevelEnabled: false });\n80\t  g.rotateX(Math.PI / 2); g.translate(0, y1, 0); g.scale(0.001, 0.001, 0.001);\n81\t  return g;\n82\t}\n83\t\n84\texport function pipe(points, r, m) {\n85\t  return new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(points, false, \"catmullrom\", 0.1), 48, r, 10, false), m);\n86\t}\n87\t\n88\t// Spur gear, axis along x.\n89\texport function gear(R, teeth, w, m) {\n90\t  const g = new THREE.Group(), body = new THREE.Mesh(new THREE.CylinderGeometry(R - 0.006, R - 0.006, w, 48), m); body.rotation.z = Math.PI / 2; g.add(body);\n91\t  for (let i = 0; i < teeth; i++) {\n92\t    const a = i / teeth * Math.PI * 2, t = new THREE.Mesh(new THREE.BoxGeometry(w, 0.012, 0.008), m);\n93\t    t.position.set(0, R * Math.cos(a), R * Math.sin(a)); t.rotation.x = a; g.add(t);\n94\t  }\n95\t  return g;\n96\t}\n97\t\n98\t// Polyline parametrised by arc length, for particles: at(pl, s ∈ [0,1], out).\n99\texport function polyline(points) {\n100\t  const segs = []; let tot = 0;\n101\t  for (let i = 1; i < points.length; i++) { const l = points[i].distanceTo(points[i - 1]); segs.push(l); tot += l; }\n102\t  return { points, segs, tot };\n103\t}\n104\texport function at(pl, s, out) {\n105\t  let d = s * pl.tot;\n106\t  for (let i = 0; i < pl.segs.length; i++) {\n107\t    if (d <= pl.segs[i] || i === pl.segs.length - 1) return out.copy(pl.points[i]).lerp(pl.points[i + 1], Math.min(1, d / pl.segs[i]));\n108\t    d -= pl.segs[i];\n109\t  }\n110\t  return out.copy(pl.points[pl.points.length - 1]);\n111\t}\n112\t\n113\t// Point cloud whose positions/colours are rewritten each frame.\n114\texport function particles(n, size = 0.026) {\n115\t  const pos = new Float32Array(n * 3), col = new Float32Array(n * 3), geo = new THREE.BufferGeometry();\n116\t  geo.setAttribute(\"position\", new THREE.BufferAttribute(pos, 3)); geo.setAttribute(\"color\", new THREE.BufferAttribute(col, 3));\n117\t  const pts = new THREE.Points(geo, new THREE.PointsMaterial({ size, vertexColors: true, transparent: true, opacity: 0.95, depthTest: false }));\n118\t  pts.renderOrder = 6;\n119\t  return { pts, pos, col, set(i, p, c) { pos.set([p.x, p.y, p.z], i * 3); col.set([c.r, c.g, c.b], i * 3); },\n120\t    flush() { geo.attributes.position.needsUpdate = true; geo.attributes.color.needsUpdate = true; } };\n121\t}\n122\t// Renderer, cameras, lights, theme tokens and the frame loop for one stop. Owns nothing car-specific.\n123\timport * as THREE from \"three\";\n124\timport { OrbitControls } from \"three/addons/controls/OrbitControls.js\";\n125\timport { mm } from \"./helpers.js\";\n126\t\n127\t// el: the .stage element (keeps the photo's aspect). car: the car config (photo, orbit, sun).\n128\texport function createStage(el, car) {\n129\t  const photo = car.photo, aspect = photo ? photo.w / photo.h : 1200 / 803;\n130\t  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n131\t  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));\n132\t  renderer.outputColorSpace = THREE.SRGBColorSpace;\n133\t  const img = el.querySelector(\"img\");   // the transparent canvas sits on top of the museum photo\n134\t  if (img) img.after(renderer.domElement); else el.prepend(renderer.domElement);\n135\t  // iOS drops WebGL contexts of background tabs; preventDefault lets the browser restore it.\n136\t  renderer.domElement.addEventListener(\"webglcontextlost\", e => e.preventDefault());\n137\t\n138\t  const scene = new THREE.Scene();\n139\t  const cam = new THREE.PerspectiveCamera(32, aspect, 0.05, 60);\n140\t  cam.up.set(0, 0, 1);\n141\t  const controls = new OrbitControls(cam, renderer.domElement);\n142\t  controls.enableDamping = true;\n143\t  controls.minDistance = car.orbit?.min ?? 0.8; controls.maxDistance = car.orbit?.max ?? 16;\n144\t\n145\t  // Camera fitted to the museum photo (tools/fit-photo-camera.mjs): position in mm, yaw/pitch/roll in rad, focal length in px.\n146\t  let photoCam = null;\n147\t  if (photo) {\n148\t    const { c, yaw, pitch, roll, f } = photo.cam;\n149\t    photoCam = new THREE.PerspectiveCamera(2 * Math.atan(photo.h / 2 / f) * 180 / Math.PI, aspect, 0.05, 60);\n150\t    const fw = new THREE.Vector3(Math.cos(pitch) * Math.cos(yaw), Math.cos(pitch) * Math.sin(yaw), Math.sin(pitch));\n151\t    const r = new THREE.Vector3().crossVectors(fw, new THREE.Vector3(0, 0, 1)).normalize();\n152\t    const u = new THREE.Vector3().crossVectors(r, fw);\n153\t    photoCam.position.copy(mm(c));\n154\t    photoCam.up.copy(u.clone().multiplyScalar(Math.cos(roll)).addScaledVector(r, -Math.sin(roll)));\n155\t    photoCam.lookAt(photoCam.position.clone().add(fw));\n156\t  }\n157\t\n158\t  // Physically based light units since r155: intensities are the PoC's r128 values × π.\n159\t  scene.add(new THREE.HemisphereLight(0xffffff, 0x445566, 0.95 * Math.PI));\n160\t  const sun = new THREE.DirectionalLight(0xffffff, 0.65 * Math.PI); sun.position.set(...(car.sun ?? [3, 4, 6])); scene.add(sun);\n161\t\n162\t  // Theme: colours live in CSS custom properties; bind(color, token) re-applies them on theme change.\n163\t  const root = document.documentElement;\n164\t  const css = n => getComputedStyle(root).getPropertyValue(n).trim();\n165\t  const cache = new Map(), bindings = [], onTheme = [];\n166\t  const color = token => { if (!cache.has(token)) cache.set(token, new THREE.Color(css(token))); return cache.get(token); };\n167\t  const isDark = () => root.dataset.theme === \"dark\" || (root.dataset.theme !== \"light\" && matchMedia(\"(prefers-color-scheme: dark)\").matches);\n168\t  let onPhoto = false;\n169\t  function applyColors() {\n170\t    cache.clear();\n171\t    for (const [c, token] of bindings) c.copy(color(token));\n172\t    scene.background = onPhoto ? null : color(\"--stage\").clone();\n173\t    for (const fn of onTheme) fn({ onPhoto, dark: isDark() });\n174\t  }\n175\t  matchMedia(\"(prefers-color-scheme: dark)\").addEventListener(\"change\", applyColors);\n176\t  new MutationObserver(applyColors).observe(root, { attributes: true, attributeFilter: [\"data-theme\"] });\n177\t\n178\t  function resize() {\n179\t    const w = el.clientWidth, h = el.clientHeight;\n180\t    if (!w || !h) return;\n181\t    renderer.setSize(w, h, false); cam.aspect = w / h; cam.updateProjectionMatrix();\n182\t  }\n183\t  new ResizeObserver(resize).observe(el);\n184\t\n185\t  const stats = { frames: 0 };\n186\t  return {\n187\t    THREE, renderer, scene, cam, photoCam, controls, css, color, isDark, stats,\n188\t    bind(c, token) { bindings.push([c, token]); c.copy(color(token)); return c; },\n189\t    tokenMat(token, o) { const m = new THREE.MeshStandardMaterial({ roughness: 0.5, metalness: 0.15, ...o }); this.bind(m.color, token); return m; },\n190\t    onTheme(fn) { onTheme.push(fn); },\n191\t    applyColors,\n192\t    setPhotoView(on) { onPhoto = on && !!photoCam; controls.enabled = !onPhoto; applyColors(); },\n193\t    setOrbit(v) { cam.position.set(...v.pos); controls.target.set(...v.target); controls.update(); },\n194\t    // onFrame(dt) runs before each render; dt in s, clamped so a paused tab or slow frame never jumps the simulation.\n195\t    // stop() pauses the loop (the canvas keeps its last frame); start() again resumes it.\n196\t    stop() { renderer.setAnimationLoop(null); },\n197\t    start(onFrame) {\n198\t      resize();\n199\t      let last = performance.now();\n200\t      renderer.setAnimationLoop(now => {\n201\t        const dt = Math.min((now - last) / 1000, 0.05); last = now;\n202\t        onFrame(dt);\n203\t        if (!onPhoto) controls.update();\n204\t        renderer.render(scene, onPhoto ? photoCam : cam);\n205\t        stats.frames++;\n206\t      });\n207\t    },\n208\t  };\n209\t}\n210\t// 2-D wind tunnel on the car's centre plane: lattice Boltzmann (D2Q9, BGK collision with a Smagorinsky eddy viscosity, so\n211\t// the wake can turn turbulent without the solver blowing up). Pure: no DOM, no three.js.\n212\t// Lattice units: one cell, one step. Air enters at column i = 0 with speed U and leaves at i = nx − 1. Row j = 0 sits on the\n213\t// road, which moves with the air (car frame: the road streams past at the car's speed, so it grows no boundary layer). The\n214\t// top is a free-slip wall; the body (solid cells) is a no-slip wall (half-way bounce-back).\n215\tconst CX = [0, 1, 0, -1, 0, 1, -1, -1, 1], CZ = [0, 0, 1, 0, -1, 1, 1, -1, -1];\n216\tconst W = [4 / 9, 1 / 9, 1 / 9, 1 / 9, 1 / 9, 1 / 36, 1 / 36, 1 / 36, 1 / 36];\n217\tconst OPP = [0, 3, 4, 1, 2, 7, 8, 5, 6], MIRROR_Z = [0, 1, 4, 3, 2, 8, 7, 6, 5];\n218\t\n219\t// Side profile (closed polygon of [x, z] in mm, x forward) → solid cells. Cell (i, j) has its centre at\n220\t// x = x0 − (i + ½)·cell, z = ground + (j + ½)·cell: the tunnel runs from the front edge x0 back to x1, up to top.\n221\texport function rasterize(profile, { x0, x1, top, cell, ground = 0 }) {\n222\t  const nx = Math.round((x0 - x1) / cell), nz = Math.round(top / cell), solid = new Uint8Array(nx * nz);\n223\t  for (let j = 0; j < nz; j++) for (let i = 0; i < nx; i++) {\n224\t    const x = x0 - (i + 0.5) * cell, z = ground + (j + 0.5) * cell;\n225\t    let inside = false;\n226\t    for (let a = 0, b = profile.length - 1; a < profile.length; b = a++) {\n227\t      const [xa, za] = profile[a], [xb, zb] = profile[b];\n228\t      if ((za > z) !== (zb > z) && x < xa + (z - za) / (zb - za) * (xb - xa)) inside = !inside;\n229\t    }\n230\t    solid[j * nx + i] = inside ? 1 : 0;\n231\t  }\n232\t  return { nx, nz, solid };\n233\t}\n234\t\n235\texport function createTunnel({ nx, nz, solid, U = 0.1, nu = 0.0015, smag = 0.16 }) {\n236\t  const N = nx * nz, tau0 = 3 * nu + 0.5, C = 18 * Math.SQRT2 * smag * smag, uu = 1.5 * U * U;\n237\t  let f = new Float32Array(9 * N), g = new Float32Array(9 * N);\n238\t  const ux = new Float32Array(N).fill(U), uz = new Float32Array(N), rho = new Float32Array(N).fill(1);\n239\t  const inflow = W.map((w, k) => w * (1 + 3 * CX[k] * U + 4.5 * (CX[k] * U) ** 2 - uu));\n240\t  for (let c = 0; c < N; c++) { f.set(inflow, 9 * c); if (solid[c]) ux[c] = 0; }\n241\t  const fe = new Float64Array(9), fo = new Float64Array(9);\n242\t  // Drag on the body this step (lattice force units, + = downstream): total by momentum exchange at the walls; the pressure\n243\t  // part split into push on upstream-facing faces and suction on downstream-facing ones; friction is the rest.\n244\t  const drag = { total: 0, push: 0, suction: 0, friction: 0 };\n245\t\n246\t  function step() {\n247\t    let fx = 0, rf = 0, nf = 0, rr = 0, nr = 0;\n248\t    for (let j = 0; j < nz; j++) for (let i = 0; i < nx; i++) {\n249\t      const c = j * nx + i; if (solid[c]) continue;\n250\t      const o = 9 * c;\n251\t      let r = 0, mx = 0, mz = 0;\n252\t      for (let k = 0; k < 9; k++) { const v = f[o + k]; r += v; mx += CX[k] * v; mz += CZ[k] * v; }\n253\t      const u = mx / r, w = mz / r, q = 1.5 * (u * u + w * w);\n254\t      rho[c] = r; ux[c] = u; uz[c] = w;\n255\t      let pxx = 0, pzz = 0, pxz = 0;\n256\t      for (let k = 0; k < 9; k++) {\n257\t        const cu = 3 * (CX[k] * u + CZ[k] * w), e = W[k] * r * (1 + cu + 0.5 * cu * cu - q), d = f[o + k] - e;\n258\t        fe[k] = e; fo[k] = d; pxx += CX[k] * CX[k] * d; pzz += CZ[k] * CZ[k] * d; pxz += CX[k] * CZ[k] * d;\n259\t      }\n260\t      // Smagorinsky: the local strain (from the non-equilibrium stress) raises the relaxation time where the flow shears.\n261\t      const tau = 0.5 * (tau0 + Math.sqrt(tau0 * tau0 + C * Math.sqrt(pxx * pxx + pzz * pzz + 2 * pxz * pxz) / r)), om = 1 / tau;\n262\t      for (let k = 0; k < 9; k++) {\n263\t        const v = fe[k] + (1 - om) * fo[k], ti = i + CX[k], tj = j + CZ[k];\n264\t        if (tj < 0) g[o + OPP[k]] = v - 6 * W[k] * r * CX[k] * U;                       // road moving at U\n265\t        else if (tj >= nz) { if (ti >= 0 && ti < nx) g[9 * (j * nx + ti) + MIRROR_Z[k]] = v; }   // free-slip top\n266\t        else if (ti < 0 || ti >= nx) continue;                                           // inlet / outlet, set below\n267\t        else if (solid[tj * nx + ti]) {                                                  // bounce back off the body\n268\t          g[o + OPP[k]] = v; fx += 2 * v * CX[k];\n269\t          if (k === 1) { rf += r; nf++; } else if (k === 3) { rr += r; nr++; }\n270\t        }\n271\t        else g[9 * (tj * nx + ti) + k] = v;\n272\t      }\n273\t    }\n274\t    for (let j = 0; j < nz; j++) {\n275\t      g.set(inflow, 9 * j * nx);\n276\t      g.copyWithin(9 * (j * nx + nx - 1), 9 * (j * nx + nx - 2), 9 * (j * nx + nx - 1));  // zero-gradient outlet\n277\t    }\n278\t    [f, g] = [g, f];\n279\t    // Reference pressure p∞: the oncoming air a few cells behind the inlet (drag builds a pressure drop along the tunnel, so\n280\t    // the inlet's own density is not the free stream's).\n281\t    let s = 0, n = 0; for (let j = 0; j < nz; j++) if (!solid[j * nx + 3]) { s += rho[j * nx + 3]; n++; }\n282\t    ref = s / n;\n283\t    drag.total = fx; drag.push = (rf - nf * ref) / 3; drag.suction = -(rr - nr * ref) / 3; drag.friction = fx - drag.push - drag.suction;\n284\t  }\n285\t\n286\t  // Pressure coefficient (p − p∞) / ½ρU² at cell c: lattice pressure is ρ/3.\n287\t  let ref = 1;\n288\t  const cp = c => (rho[c] - ref) / 3 / (0.5 * U * U);\n289\t  // Bilinear velocity at fractional cell coordinates (cell centres at integers), for tracer particles. Solid cells read 0.\n290\t  function sample(x, z, out) {\n291\t    const i = Math.max(0, Math.min(nx - 1.001, x)), j = Math.max(0, Math.min(nz - 1.001, z)), i0 = i | 0, j0 = j | 0, a = i - i0, b = j - j0;\n292\t    const c = j0 * nx + i0, w00 = (1 - a) * (1 - b), w10 = a * (1 - b), w01 = (1 - a) * b, w11 = a * b;\n293\t    out[0] = w00 * ux[c] + w10 * ux[c + 1] + w01 * ux[c + nx] + w11 * ux[c + nx + 1];\n294\t    out[1] = w00 * uz[c] + w10 * uz[c + 1] + w01 * uz[c + nx] + w11 * uz[c + nx + 1];\n295\t    return out;\n296\t  }\n297\t  return { nx, nz, U, solid, ux, uz, rho, drag, step, cp, sample };\n298\t}\n299\t"}]},"uuid":"1a0f0d26-f30c-4467-898d-e021ac3db387","timestamp":"2026-11-25T20:57:36.042Z","toolUseResult":{"type":"text","file":{"filePath":"/private/tmp/claude-501/-Users-kunabel-workspace-MercedesExperience/5216a6b1-4da7-448e-be48-b0eb888aff5f/scratchpad/r1.txt","content":"// Geometry helpers shared by all subsystems. Scene units are metres; hardpoints are mm in the vehicle frame (x fwd, y left, z up).\nimport * as THREE from \"three\";\n\nexport const V = (x, y, z) => new THREE.Vector3(x, y, z);\nexport const mm = v => V(v[0] / 1000, v[1] / 1000, v[2] / 1000);\nexport const Y = V(0, 1, 0);\nconst cylGeo = new THREE.CylinderGeometry(1, 1, 1, 16), sphGeo = new THREE.SphereGeometry(1, 16, 12);\n\nexport const mat = (c = 0xffffff, o = {}) => new THREE.MeshStandardMaterial({ color: c, roughness: 0.5, metalness: 0.15, ...o });\nexport const glass = (c = 0x8fa3b3, opacity = 0.12) => new THREE.MeshStandardMaterial({ color: c, transparent: true, opacity, depthWrite: false, side: THREE.DoubleSide });\nexport const line = (c = 0x8fa3b3, opacity = 0.6) => new THREE.LineBasicMaterial({ color: c, transparent: true, opacity });\n\n// Unit cylinder stretched between two points by place(); r = radius (m).\nexport function rod(m, r) { const o = new THREE.Mesh(cylGeo, m); o.userData.r = r; return o; }\nexport function place(o, a, b) {\n  const d = new THREE.Vector3().subVectors(b, a), len = d.length();\n  o.position.copy(a).addScaledVector(d, 0.5);\n  if (len > 1e-9) o.quaternion.setFromUnitVectors(Y, d.multiplyScalar(1 / len));\n  o.scale.set(o.userData.r, Math.max(len, 1e-6), o.userData.r);\n  return o;\n}\nexport function ball(m, r, p) { const o = new THREE.Mesh(sphGeo, m); o.scale.setScalar(r); if (p) o.position.copy(p); return o; }\n\n// Coil spring between a and b.\nexport function helix(a, b, turns = 7, r = 0.046, wire = 0.007) {\n  const d = new THREE.Vector3().subVectors(b, a), len = d.length(), n = d.clone().normalize();\n  const t1 = V(1, 0, 0).cross(n).normalize(), t2 = n.clone().cross(t1), pts = [];\n  for (let i = 0; i <= 200; i++) {\n    const u = i / 200, th = u * Math.PI * 2 * turns;\n    pts.push(a.clone().addScaledVector(n, u * len).addScaledVector(t1, Math.cos(th) * r).addScaledVector(t2, Math.sin(th) * r));\n  }\n  return new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts), 200, wire, 6, false);\n}\n\n// Tyre (torus) with its axis along y. R = ring radius, r = section radius (m).\nexport function tyre(m, R = 0.235, r = 0.057) {\n  const g = new THREE.Group();\n  const t = new THREE.Mesh(new THREE.TorusGeometry(R, r, 14, 56), m); t.rotation.x = Math.PI / 2; g.add(t);\n  return g;\n}\n\n// Tyre on a wire wheel, axis along y. spokeMat is a LineBasicMaterial; spokeMat.userData.solid is the rim material.\nexport function wireWheel(tyreMat, spokeMat, R = 0.295, r = 0.085, spokeR = 0.215, spokes = 32) {\n  const g = tyre(tyreMat, R, r);\n  if (spokeMat) {\n    const pts = [];\n    for (let i = 0; i < spokes; i++) {\n      const a = i / spokes * Math.PI * 2, side = i % 2 ? 0.035 : -0.035;\n      pts.push(0, side, 0, spokeR * Math.cos(a), 0, spokeR * Math.sin(a));\n    }\n    const sg = new THREE.BufferGeometry(); sg.setAttribute(\"position\", new THREE.Float32BufferAttribute(pts, 3));\n    g.add(new THREE.LineSegments(sg, spokeMat));\n    const rim = new THREE.Mesh(new THREE.TorusGeometry(spokeR, 0.008, 6, 48), spokeMat.userData.solid); rim.rotation.x = Math.PI / 2; g.add(rim);\n  }\n  return g;\n}\n\n// Wooden artillery-style wheel (spokes as rods), axis along y.\nexport function spokedWheel(tyreMat, spokeMat, R = 0.42, spokes = 12) {\n  const g = tyre(tyreMat, R, 0.022);\n  for (let i = 0; i < spokes; i++) { const a = i / spokes * Math.PI * 2; g.add(place(rod(spokeMat, 0.012), V(0, 0, 0), V(R * Math.cos(a), 0, R * Math.sin(a)))); }\n  g.add(place(rod(spokeMat, 0.05), V(0, -0.06, 0), V(0, 0.06, 0)));\n  return g;\n}\n\nexport function edgesOf(geo, group, fillMat, lineMat, thresh = 22) {\n  group.add(new THREE.Mesh(geo, fillMat), new THREE.LineSegments(new THREE.EdgesGeometry(geo, thresh), lineMat));\n}\n\n// Points along an arc in a 2-D profile (mm, degrees).\nexport const arc = (cx, cz, r, a0, a1, n = 14) => Array.from({ length: n + 1 }, (_, i) => {\n  const a = (a0 + (a1 - a0) * i / n) * Math.PI / 180; return [cx + r * Math.cos(a), cz + r * Math.sin(a)];\n});\n\n// Side-profile polygon (x, z in mm) extruded across y from y0 to y1 (mm). Entries may be { arc: [cx, cz, r, a0, a1, n] }.\nexport function profileExtrude(pts, y0, y1) {\n  const flat = pts.flatMap(p => (p.arc ? arc(...p.arc) : [p]));\n  const s = new THREE.Shape(); s.moveTo(flat[0][0], flat[0][1]); for (const p of flat.slice(1)) s.lineTo(p[0], p[1]);\n  const g = new THREE.ExtrudeGeometry(s, { depth: y1 - y0, bevelEnabled: false });\n  g.rotateX(Math.PI / 2); g.translate(0, y1, 0); g.scale(0.001, 0.001, 0.001);\n  return g;\n}\n\nexport function pipe(points, r, m) {\n  return new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(points, false, \"catmullrom\", 0.1), 48, r, 10, false), m);\n}\n\n// Spur gear, axis along x.\nexport function gear(R, teeth, w, m) {\n  const g = new THREE.Group(), body = new THREE.Mesh(new THREE.CylinderGeometry(R - 0.006, R - 0.006, w, 48), m); body.rotation.z = Math.PI / 2; g.add(body);\n  for (let i = 0; i < teeth; i++) {\n    const a = i / teeth * Math.PI * 2, t = new THREE.Mesh(new THREE.BoxGeometry(w, 0.012, 0.008), m);\n    t.position.set(0, R * Math.cos(a), R * Math.sin(a)); t.rotation.x = a; g.add(t);\n  }\n  return g;\n}\n\n// Polyline parametrised by arc length, for particles: at(pl, s ∈ [0,1], out).\nexport function polyline(points) {\n  const segs = []; let tot = 0;\n  for (let i = 1; i < points.length; i++) { const l = points[i].distanceTo(points[i - 1]); segs.push(l); tot += l; }\n  return { points, segs, tot };\n}\nexport function at(pl, s, out) {\n  let d = s * pl.tot;\n  for (let i = 0; i < pl.segs.length; i++) {\n    if (d <= pl.segs[i] || i === pl.segs.length - 1) return out.copy(pl.points[i]).lerp(pl.points[i + 1], Math.min(1, d / pl.segs[i]));\n    d -= pl.segs[i];\n  }\n  return out.copy(pl.points[pl.points.length - 1]);\n}\n\n// Point cloud whose positions/colours are rewritten each frame.\nexport function particles(n, size = 0.026) {\n  const pos = new Float32Array(n * 3), col = new Float32Array(n * 3), geo = new THREE.BufferGeometry();\n  geo.setAttribute(\"position\", new THREE.BufferAttribute(pos, 3)); geo.setAttribute(\"color\", new THREE.BufferAttribute(col, 3));\n  const pts = new THREE.Points(geo, new THREE.PointsMaterial({ size, vertexColors: true, transparent: true, opacity: 0.95, depthTest: false }));\n  pts.renderOrder = 6;\n  return { pts, pos, col, set(i, p, c) { pos.set([p.x, p.y, p.z], i * 3); col.set([c.r, c.g, c.b], i * 3); },\n    flush() { geo.attributes.position.needsUpdate = true; geo.attributes.color.needsUpdate = true; } };\n}\n// Renderer, cameras, lights, theme tokens and the frame loop for one stop. Owns nothing car-specific.\nimport * as THREE from \"three\";\nimport { OrbitControls } from \"three/addons/controls/OrbitControls.js\";\nimport { mm } from \"./helpers.js\";\n\n// el: the .stage element (keeps the photo's aspect). car: the car config (photo, orbit, sun).\nexport function createStage(el, car) {\n  const photo = car.photo, aspect = photo ? photo.w / photo.h : 1200 / 803;\n  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));\n  renderer.outputColorSpace = THREE.SRGBColorSpace;\n  const img = el.querySelector(\"img\");   // the transparent canvas sits on top of the museum photo\n  if (img) img.after(renderer.domElement); else el.prepend(renderer.domElement);\n  // iOS drops WebGL contexts of background tabs; preventDefault lets the browser restore it.\n  renderer.domElement.addEventListener(\"webglcontextlost\", e => e.preventDefault());\n\n  const scene = new THREE.Scene();\n  const cam = new THREE.PerspectiveCamera(32, aspect, 0.05, 60);\n  cam.up.set(0, 0, 1);\n  const controls = new OrbitControls(cam, renderer.domElement);\n  controls.enableDamping = true;\n  controls.minDistance = car.orbit?.min ?? 0.8; controls.maxDistance = car.orbit?.max ?? 16;\n\n  // Camera fitted to the museum photo (tools/fit-photo-camera.mjs): position in mm, yaw/pitch/roll in rad, focal length in px.\n  let photoCam = null;\n  if (photo) {\n    const { c, yaw, pitch, roll, f } = photo.cam;\n    photoCam = new THREE.PerspectiveCamera(2 * Math.atan(photo.h / 2 / f) * 180 / Math.PI, aspect, 0.05, 60);\n    const fw = new THREE.Vector3(Math.cos(pitch) * Math.cos(yaw), Math.cos(pitch) * Math.sin(yaw), Math.sin(pitch));\n    const r = new THREE.Vector3().crossVectors(fw, new THREE.Vector3(0, 0, 1)).normalize();\n    const u = new THREE.Vector3().crossVectors(r, fw);\n    photoCam.position.copy(mm(c));\n    photoCam.up.copy(u.clone().multiplyScalar(Math.cos(roll)).addScaledVector(r, -Math.sin(roll)));\n    photoCam.lookAt(photoCam.position.clone().add(fw));\n  }\n\n  // Physically based light units since r155: intensities are the PoC's r128 values × π.\n  scene.add(new THREE.HemisphereLight(0xffffff, 0x445566, 0.95 * Math.PI));\n  const sun = new THREE.DirectionalLight(0xffffff, 0.65 * Math.PI); sun.position.set(...(car.sun ?? [3, 4, 6])); scene.add(sun);\n\n  // Theme: colours live in CSS custom properties; bind(color, token) re-applies them on theme change.\n  const root = document.documentElement;\n  const css = n => getComputedStyle(root).getPropertyValue(n).trim();\n  const cache = new Map(), bindings = [], onTheme = [];\n  const color = token => { if (!cache.has(token)) cache.set(token, new THREE.Color(css(token))); return cache.get(token); };\n  const isDark = () => root.dataset.theme === \"dark\" || (root.dataset.theme !== \"light\" && matchMedia(\"(prefers-color-scheme: dark)\").matches);\n  let onPhoto = false;\n  function applyColors() {\n    cache.clear();\n    for (const [c, token] of bindings) c.copy(color(token));\n    scene.background = onPhoto ? null : color(\"--stage\").clone();\n    for (const fn of onTheme) fn({ onPhoto, dark: isDark() });\n  }\n  matchMedia(\"(prefers-color-scheme: dark)\").addEventListener(\"change\", applyColors);\n  new MutationObserver(applyColors).observe(root, { attributes: true, attributeFilter: [\"data-theme\"] });\n\n  function resize() {\n    const w = el.clientWidth, h = el.clientHeight;\n    if (!w || !h) return;\n    renderer.setSize(w, h, false); cam.aspect = w / h; cam.updateProjectionMatrix();\n  }\n  new ResizeObserver(resize).observe(el);\n\n  const stats = { frames: 0 };\n  return {\n    THREE, renderer, scene, cam, photoCam, controls, css, color, isDark, stats,\n    bind(c, token) { bindings.push([c, token]); c.copy(color(token)); return c; },\n    tokenMat(token, o) { const m = new THREE.MeshStandardMaterial({ roughness: 0.5, metalness: 0.1