(k + 0.5) * h];\n27\t  const clamp = (v, n) => Math.max(0, Math.min(n - 1, v));\n28\t  const cell = (x, y, z) => [clamp(Math.round((x0 - x) / h - 0.5), nx), ny === 1 ? 0 : clamp(Math.round(((mirror ? Math.abs(y) : y) - y0) / h - 0.5), ny), clamp(Math.round(z / h - 0.5), nz)];\n29\t  const vel = (x, y, z) => {\n30\t    const yy = mirror ? Math.abs(y) : y, fi = (x0 - x) / h - 0.5, fj = (yy - y0) / h - 0.5, fk = z / h - 0.5;\n31\t    if (fi < 0 || fi >= nx - 1 || fk < 0 || fk >= nz - 1) return null;\n32\t    if (ny > 1 && (fj >= ny - 1 || (!mirror && fj < 0))) return null;   // a single row (a 2-D run) is the same at every y\n33\t    const i0 = fi | 0, k0 = fk | 0, a = fi - i0, c = fk - k0, j0 = ny > 1 ? Math.max(0, Math.min(ny - 2, Math.floor(fj))) : 0, b = ny > 1 ? Math.max(0, Math.min(1, fj - j0)) : 0;\n34\t    let u = 0, v = 0, w = 0;\n35\t    for (let n = 0; n < 8; n++) {\n36\t      const di = n & 1, dj = (n >> 1) & 1, dk = n >> 2;\n37\t      if (dj && ny === 1) continue;\n38\t      const q = at(i0 + di, j0 + dj, k0 + dk);\n39\t      if (r.solid[q]) return null;\n40\t      const wt = (di ? a : 1 - a) * (dj ? b : 1 - b) * (dk ? c : 1 - c);\n41\t      u += wt * r.ui[q]; v += wt * r.uj[q]; w += wt * r.uk[q];\n42\t    }\n43\t    return [-u / U, (mirror && y < 0 ? -1 : 1) * v / U, w / U];\n44\t  };\n45\t  return { ...r, y0, N: nx * ny * nz, at, centre, cell, vel };\n46\t}\n47\t\n48\t// Mean of the rearward and upward velocity over the fluid cells whose centres lie in a box (mm: [lo, hi] per axis), and\n49\t// its direction in the side view: atan2(up, rearward) in degrees (+ = air rising as it leaves rearward).\n50\texport function probe(r, box) {\n51\t  let n = 0, ui = 0, uk = 0, uj = 0;\n52\t  for (let k = 0; k < r.nz; k++) for (let j = 0; j < r.ny; j++) for (let i = 0; i < r.nx; i++) {\n53\t    const [x, y, z] = r.centre(i, j, k);\n54\t    if (x < box.x[0] || x > box.x[1] || y < box.y[0] || y > box.y[1] || z < box.z[0] || z > box.z[1]) continue;\n55\t    const c = r.