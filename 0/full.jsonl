l 3-D runs of the front corner (tools/cfd/part.mjs w196-wheel, tools/cfd/corner.mjs); body sizes assumed.","+        cases: [","+          { id: \"enclosed\", label: \"Enclosed\", say: \"WHEEL_ENCLOSED\" },","+          { id: \"exposed\", label: \"Exposed\", say: \"WHEEL_EXPOSED\" },","         ],","-        power: { min: 100, max: 400 }, vmax: 340,","-        nose: [1380, 420], wheel: [-2350, 0], time: 3,","-        // Centre-plane section for the 2-D wind tunnel, from the ghost outline: the screen and head fairing on the centre line,","-        // the mouth closed, the underside flat. The wheels stand outside the slice, so both bodies share it.","-        flow: {","-          x0: 2800, x1: -8100, top: 3200, cell: 50, show: [-6600, 2400], rake: [100, 2000, 20],","-          profile: [[1380, 260], [1380, 420], [1300, 540], [1100, 640], [900, 700], [600, 740], [-300, 760], [-700, 770], [-850, 1000], [-950, 1040],","-            [-1300, 1050], [-1600, 950], [-1900, 790], [-2350, 780], [-2800, 720], [-3150, 620], [-3280, 420], [-3300, 260], [-3150, 150], [1250, 150]],","-        },","       },","-      talk: [","-        \"For the new 2.5-litre Formula 1 of 1954, Mercedes planned two bodies from the start: this streamlined one for very fast circuits, and a classic one with open wheels.\",","-        \"A spinning, exposed wheel churns the air and leaves a big wake. Covering the wheels makes the body wider, so it pushes more air aside, yet the total drag still falls. Switch bodies: at the same 290 hp the streamliner is about 20 km/h faster in this model.\",","-        \"It won first time out, at Reims on 4 July 1954: Fangio ahead of Kling. Two weeks later, on the tight Silverstone circuit, the drivers could not place the enclosed front wheels precisely in the corners and finished only 4th and 7th.\",","-        \"In 1955 the streamliner raced only once, at Monza with its new steep banking, where Fangio won. The M 196 engine, a straight eight with direct injection and desmodromic valves, now gave 290 hp at 8,500 rpm.\",","-        \"The wind tunnel shows the slice along the centre line, through the driver's head fairing: the air presses on the low nose, speeds up over the body and leaves a wake behind the short tail. The wheels stand outside the slice, so both bodies show the same section here.\",","-      ],","+      talk: [\"WHEEL_TALK\"],","     },","     {","       id: \"engine\", label: \"Engine\", subsystem: \"inline-engine\","]}]},{"filePath":"/Users/kunabel/workspace/MercedesExperience/tools/cfd/part.mjs","hunks":[{"oldStart":142,"oldLines":9,"newStart":142,"newLines":9,"lines":[" "," // ---------------------------------------------------------------- front corners (3-D)"," const CORNER = {","-  \"w196-wheel\": { slug: \"w196r\", cases: [\"enclosed\", \"exposed\"], plane: 344, station: -700, shoulder: 740, below: 0.8,","+  \"w196-wheel\": { slug: \"w196r\", folder: \"wheel\", cases: [\"enclosed\", \"exposed\"], plane: 344, station: -700, shoulder: 740, below: 0.8,","     seeds: [500, 600, 700, 800, 900, 1000, 1100, 1250].map(y => [2200, y, 344]), crop: { x: [1700, -1500], y: [0, 1500] } },","-  \"evo-arch\": { slug: \"190e-evo2\", cases: [\"fitted\"], plane: 344, station: -600, seeds: [700, 740, 780, 820, 860, 920, 1000, 1100].map(y => [1500, y, 344]),","+  \"evo-arch\": { slug: \"190e-evo2\", folder: \"wheel-arch\", cases: [\"fitted\"], plane: 344, station: -600, seeds: [700, 740, 780, 820, 860, 920, 1000, 1100].map(y => [1500, y, 344]),","     crop: { x: [1300, -1300], y: [0, 1400] }, follow: 780 },","   grids: [24, 16], U: 0.08, Re: 1e4, D: 680,"," };"]},{"oldStart":226,"oldLines":15,"newStart":226,"newLines":15,"lines":["     }","     f.cases[c] = { lines, guides, ...(p === \"evo-arch\" ? { follow: [0] } : {}) };","   }","-  publish(p, P.slug, f, bins, rec);","+  publish(p, P.slug, f, bins, rec, P.folder);"," }"," "," // ---------------------------------------------------------------- publishing","-function publish(p, sl