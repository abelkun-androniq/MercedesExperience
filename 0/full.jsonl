{"parentUuid":"aae2f28b-f190-4284-96e1-362ecd2784f6","isSidechain":false,"promptId":"520f657a-52b6-42e2-ac69-925bae4d884a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N1stKqYTKd5Bb2sWGxhWpb","type":"tool_result","content":"1\t// Every stop on the route loads, renders and animates, and scrolling its story sets what the stage shows, on each emulated\n2\t// device.\n3\timport { test, expect } from \"@playwright/test\";\n4\timport tour, { teaser } from \"../../stops/tour.js\";\n5\timport { watchErrors, stepsOf, shown } from \"./helpers.mjs\";\n6\t\n7\tconst cars = await Promise.all(tour.map(async s => (await import(`../../stops/${s.slug}/car.js`)).default));\n8\t\n9\tfor (const car of cars) {\n10\t  test(`${car.slug}: the story's steps set the stage, readouts move`, async ({ page }) => {\n11\t    const errors = watchErrors(page);\n12\t    await page.goto(`stop.html?s=${car.slug}&debug`);\n13\t    await page.waitForFunction(() => window.__tour?.stories[0].frames() > 10, null, { timeout: 20_000 });\n14\t    await expect(page.locator(\".step\")).toHaveCount(car.components.length + 2);\n15\t\n16\t    const pinned = new Set();\n17\t    for (const [k, want] of stepsOf(car).entries()) {\n18\t      const step = page.locator(\".step\").nth(k);\n19\t      await step.evaluate(s => s.scrollIntoView({ block: \"center\" }));\n20\t      await expect.poll(() => shown(page)).toEqual({ step: k, state: want });\n21\t      await expect(page.locator(\".stage img\")).toBeVisible({ visible: want.view === \"photo\" });\n22\t      if (k === 0 || k > car.components.length) continue;   // intro and background: no component cards\n23\t      pinned.add(await page.locator(\".stage\").evaluate(s => Math.round(s.getBoundingClientRect().top)));\n24\t      await expect.poll(() => page.evaluate(() => window.__tour.stories[0].triangles())).toBeGreaterThan(0);\n25\t      const readouts = () => step.locator(`.panel[data-comp=\"${want.comp}\"] output`).allTextContents();\n26\t      const before = await readouts();\n27\t      expect(before.length).toBeGreaterThan(0);\n28\t      // Precomputed results (race-aero) stand still until another case is chosen: press the first case button (race-aero starts\n29\t      // on a later one; animated components move either way).\n30\t      if (car.components.find(c => c.id === want.comp).params.cases) await step.locator(`.panel[data-comp=\"${want.comp}\"] button`).first().click();\n31\t      await expect.poll(readouts, { timeout: 15_000 }).not.toEqual(before);\n32\t    }\n33\t    expect(pinned.size, \"stage stays put through the component steps\").toBe(1);\n34\t\n35\t    const fit = await page.evaluate(() => ({ scrollW: document.documentElement.scrollWidth, w: innerWidth, h: innerHeight, stage: document.querySelector(\".stage\").getBoundingClientRect().height }));\n36\t    expect(fit.scrollW, \"no horizontal scroll\").toBeLessThanOrEqual(fit.w);\n37\t    expect(fit.stage, \"stage fits the viewport height\").toBeLessThanOrEqual(fit.h);\n38\t    expect(errors).toEqual([]);\n39\t  });\n40\t}\n41\t\n42\ttest(\"index lists every stop in walking order\", async ({ page }) => {\n43\t  const errors = watchErrors(page);\n44\t  await page.goto(\"./\");\n45\t  const links = page.locator('a[href^=\"stop.html?s=\"]');\n46\t  await expect(links).toHaveCount(tour.length);\n47\t  expect(await links.evaluateAll(as => as.map(a => new URL(a.href).searchParams.get(\"s\")))).toEqual(tour.map(s => s.slug));\n48\t  expect(errors).toEqual([]);\n49\t});\n50\t\n51\ttest(\"index: room jump links reach their rooms; highlights and back again\", async ({ page }) => {\n52\t  const errors = watchErrors(page);\n53\t  await page.goto(\"./\");\n54\t  const jumps = page.locator(\".jump a\");\n55\t  await expect(jumps).toHaveCount(new Set(tour.map(s => `${s.room} ${s.level}`)).size);\n56\t  for (const href of await jumps.evaluateAll(as => as.map(a => a.getAttribute(\"href\")))) await expect(page.locator(href)).toHaveClass(\"room\");\n57\t  await page.locator('.jump a[href=\"#room-legend-6\"]').click();\n58\t  await expect(page.locator(\"#room-legend-6 h2\")).toBeInViewport();\n59\t  await page.getByRole(\"link\", { name: \"Three highlights\" }).click();\n60\t  await expect(page).toHaveURL(/teaser\\.html$/);\n61\t  await expect(page.getByRole(\"link\", { name: \"See the full route\" })).toHaveAttribute(\"href\", \"./#jump\");\n62\t  expect(errors).toEqual([]);\n63\t});\n64\t\n65\ttest(\"index: “Find your room” and a fresh ./#jump both bring the room picker into view\", async ({ page }) => {\n66\t  const errors = watchErrors(page);\n67\t  await page.goto(\"./\");\n68\t  await expect(page.locator(\".jump a\").first()).toBeVisible();\n69\t  await page.getByRole(\"link\", { name: \"Find your room\" }).click();\n70\t  await expect(page.locator(\"#jump-title\")).toBeInViewport();\n71\t  await expect(page.locator(\".jump a\").first()).toBeInViewport();\n72\t  await page.goto(\"about:blank\");\n73\t  await page.goto(\"./#jump\");\n74\t  await expect(page.locator(\".jump a\").first()).toBeInViewport();\n75\t  await expect(page.locator(\"#jump-title\")).toBeInViewport();\n76\t  expect(errors).toEqual([]);\n77\t});\n78\t\n79\tfor (const lang of [\"en\", \"hu\"]) {\n80\t  test(`SLK roof steps (${lang}): every label fits its cell and names the movement in either direction`, async ({ page }) => {\n81\t    const errors = watchErrors(page);\n82\t    await page.addInitScript(l => localStorage.setItem(\"tour-lang\", l), lang);\n83\t    await page.goto(\"stop.html?s=slk&debug\");\n84\t    await page.waitForFunction(() => window.__tour?.stories[0].frames() > 2, null, { timeout: 20_000 });\n85\t    const step = page.locator(\".step\").nth(1);\n86\t    await step.evaluate(s => s.scrollIntoView({ block: \"center\" }));\n87\t    const cells = step.locator(\".cyls .cyl\");\n88\t    await expect(cells).toHaveCount(4);\n89\t    const labels = () => cells.locator(\"b\").allTextContents();\n90\t    const overflowing = () => cells.evaluateAll(cs => cs.filter(c => c.scrollWidth > c.clientWidth).map(c => c.firstChild.textContent));\n91\t    const buttons = step.locator(\".row\").first().locator(\"button\");\n92\t    await buttons.nth(0).click();   // Open the roof\n93\t    expect(await labels()).toEqual(lang === \"en\" ? [\"Unlatch\", \"Boot lid up\", \"Roof folds back\", \"Boot lid down\"] : [\"Reteszoldás\", \"Fedél nyílik\", \"A tető hátrahajlik\", \"Fedél zárul\"]);\n94\t    expect(await overflowing()).toEqual([]);\n95\t    await buttons.nth(1).click();   // Close the roof\n96\t    await expect.poll(labels).toEqual(lang === \"en\" ? [\"Boot lid up\", \"Roof folds forward\", \"Boot lid down\", \"Latch\"] : [\"Fedél nyílik\", \"A tető előrehajlik\", \"Fedél zárul\", \"Reteszelés\"]);\n97\t    expect(await overflowing()).toEqual([]);\n98\t    expect(errors).toEqual([]);\n99\t  });\n100\t}\n101\t\n102\ttest(\"switching language keeps the experiment: the 300 SL's lowered frame stays chosen and in view\", async ({ page }) => {\n103\t  const errors = watchErrors(page);\n104\t  await page.addInitScript(() => { if (!localStorage.getItem(\"tour-lang\")) localStorage.setItem(\"tour-lang\", \"en\"); });\n105\t  await page.goto(\"stop.html?s=300sl&debug\");\n106\t  await page.waitForFunction(() => window.__tour?.stories[0].frames() > 2, null, { timeout: 20_000 });\n107\t  await page.locator(\".step\").nth(1).evaluate(s => s.scrollIntoView({ block: \"center\" }));\n108\t  await expect.poll(() => shown(page)).toMatchObject({ step: 1, state: { comp: \"frame\" } });\n109\t  await page.getByRole(\"button\", { name: \"Lower sill for conventional doors\" }).click();\n110\t  for (const [to, lower] of [[\"Magyar\", \"Alacsony küszöb hagyományos ajtóhoz\"], [\"English\", \"Lower sill for conventional doors\"]]) {\n111\t    await page.getByRole(\"button\", { name: to }).click();\n112\t    await page.waitForFunction(() => window.__tour?.stories[0].frames() > 2, null, { timeout: 20_000 });\n113\t    const button = page.getByRole(\"button\", { name: lower });\n114\t    await expect(button).toHaveAttribute(\"aria-pressed\", \"true\");\n115\t    await expect(button).toBeInViewport();\n116\t    await expect.poll(() => shown(page)).toMatchObject({ step: 1, state: { comp: \"frame\" } });\n117\t  }\n118\t  expect(errors).toEqual([]);\n119\t});\n120\t\n121\ttest(\"the stop's photo, credit and introduction show even when 3D cannot load\", async ({ page }) => {\n122\t  await page.route(/vendor\\/three\\//, r => r.abort());\n123\t  await page.goto(\"stop.html?s=slk\");\n124\t  await expect(page.locator(\".story-stage .fail\")).toBeVisible();\n125\t  await expect(page.locator(\".stage img\")).toBeVisible();\n126\t  await expect(page.locator(\".stage .credit\")).toBeVisible();\n127\t  await expect(page.locator(\".stage .caption\")).toHaveText(\"Reference photo of the same generation, not the museum's car\");\n128\t  await expect(page.locator(\"h1\")).toBeVisible();\n129\t  await expect(page.locator(\".step .look\").first()).toBeVisible();\n130\t});\n131\t\n132\ttest(\"a real-part photo swaps places with the stage; a tap on the 3D view or scrolling away swaps them back\", async ({ page }) => {\n133\t  const errors = watchErrors(page);\n134\t  await page.goto(\"stop.html?s=540k&debug\");\n135\t  await page.waitForFunction(() => window.__tour?.stories[0].frames() > 2, null, { timeout: 20_000 });\n136\t  const swapped = () => page.evaluate(() => window.__tour.stories[0].swapped());\n137\t  const pane = page.locator(\".story-stage\"), fig = page.locator(\"figure.real\").first();\n138\t  // The photo just below the pinned stage, as a visitor sees it before tapping.\n139\t  await page.evaluate(() => scrollBy(0, document.querySelector(\"figure.real\").getBoundingClientRect().top - document.querySelector(\".story-stage\").getBoundingClientRect().height - 20));\n140\t  const height = (await pane.boundingBox()).height;\n141\t\n142\t  await fig.locator(\".real-open\").click();\n143\t  expect(await swapped()).toBe(true);\n144\t  await expect(pane.locator(\".real-open img\")).toBeVisible();\n145\t  await expect(fig.locator(\".stage canvas\")).toBeVisible();\n146\t  expect((await pane.boundingBox()).height, \"the pinned area keeps its size\").toBeCloseTo(height, 0);\n147\t\n148\t  const box = await fig.locator(\".stage\").boundingBox();\n149\t  await page.mouse.click(box.x + box.width / 2, box.y + box.height / 2);\n150\t  expect(await swapped()).toBe(false);\n151\t  await expect(pane.locator(\".stage canvas\")).toBeVisible();\n152\t\n153\t  await fig.locator(\".real-open\").click();\n154\t  await pane.locator(\".real-open\").click();   // the big photo swaps back too\n155\t  expect(await swapped()).toBe(false);\n156\t\n157\t  await fig.locator(\".real-open\").click();\n158\t  await page.evaluate(() => scrollBy(0, 2 * innerHeight));\n159\t  await expect.poll(swapped).toBe(false);\n160\t  await expect(pane.locator(\":scope > .stage\")).toHaveCount(1);\n161\t  expect(errors).toEqual([]);\n162\t});\n163\t\n164\ttest(\"unknown stop shows the not-found message and loads no 3D code\", async ({ page }) => {\n165\t  const three = [];\n166\t  page.on(\"request\", r => { if (/vendor\\/three|subsystems\\//.test(r.url())) three.push(r.url()); });\n167\t  await page.goto(\"stop.html?s=../../etc\");\n168\t  await expect(page.getByRole(\"heading\", { name: \"Stop not found\" })).toBeVisible();\n169\t  expect(three).toEqual([]);\n170\t});\n171\t\n172\ttest(\"teaser lists its three stops; opened from there, they page between each other\", async ({ page }) => {\n173\t  const errors = watchErrors(page);\n174\t  const order = tour.filter(s => teaser.includes(s.slug)).map(s => s.slug), href = s => `stop.html?s=${s}&r=teaser`;\n175\t  await page.goto(\"teaser.html?debug\");\n176\t  await page.waitForLoadState(\"networkidle\");   // leaving mid-load aborts imports\n177\t  const links = page.locator('a[href^=\"stop.html?s=\"]');\n178\t  await expect(links).toHaveCount(3);\n179\t  expect(await links.evaluateAll(as => as.map(a => a.getAttribute(\"href\")))).toEqual(order.map(href));\n180\t\n181\t  for (const [i, slug] of order.entries()) {\n182\t    await page.goto(`${href(slug)}&debug`);\n183\t    await page.waitForFunction(() => window.__tour?.stories[0].frames() > 5, null, { timeout: 20_000 });   // leaving mid-load aborts imports\n184\t    await expect(page.locator(\"#where\")).toContainText(`Stop ${i + 1} of 3`);\n185\t    await expect(page.getByRole(\"link\", { name: \"← Highlights\" })).toHaveAttribute(\"href\", \"teaser.html\");\n186\t    const pager = await page.locator(\".pager a\").evaluateAll(as => as.map(a => a.getAttribute(\"href\")));\n187\t    expect(pager).toEqual([order[i - 1], order[i + 1]].filter(Boolean).map(href));\n188\t  }\n189\t\n190\t  const other = tour.find(s => !teaser.includes(s.slug)).slug;   // not a teaser stop: the full tour's paging\n191\t  await page.goto(`stop.html?s=${other}&r=teaser&debug`);\n192\t  await page.waitForFunction(() => window.__tour?.stories[0].frames() > 5, null, { timeout: 20_000 });\n193\t  await expect(page.locator(\"#where\")).toContainText(`of ${tour.length}`);\n194\t  await expect(page.getByRole(\"link\", { name: \"← Tour route\" })).toHaveAttribute(\"href\", \"./\");\n195\t  expect(errors).toEqual([]);\n196\t});\n197\t\n198\ttest(\"teaser: each car's stage stays pinned while its steps scroll past and set what it shows\", async ({ page }) => {\n199\t  const errors = watchErrors(page);\n200\t  await page.goto(\"teaser.html?debug\");\n201\t  await page.waitForFunction(() => window.__tour?.ready, null, { timeout: 30_000 });\n202\t  const frames = () => page.evaluate(() => window.__tour.stories.map(s => s.frames()));\n203\t\n204\t  for (const [i, car] of cars.filter(c => teaser.includes(c.slug)).entries()) {\n205\t    const el = page.locator(\".story\").nth(i), steps = stepsOf(car);\n206\t    await expect(el.locator(\".step\")).toHaveCount(steps.length);\n207\t    const pinned = new Set();\n208\t    for (const [k, want] of steps.entries()) {\n209\t      await el.locator(\".step\").nth(k).evaluate(s => s.scrollIntoView({ block: \"center\" }));\n210\t      await expect.poll(() => shown(page, i)).toEqual({ step: k, state: want });\n211\t      if (want.view !== \"model\") continue;\n212\t      pinned.add(await el.locator(\".stage\").evaluate(s => Math.round(s.getBoundingClientRect().top)));\n213\t      if (k > 1) continue;   // on the first component: only this car's stage animates\n214\t      await page.waitForTimeout(300);\n215\t      const f0 = await frames(); await page.waitForTimeout(600); const f1 = await frames();\n216\t      expect(f1.map((f, j) => f > f0[j]), \"animating stages\").toEqual(f1.map((_, j) => j === i));\n217\t    }\n218\t    expect(pinned.size, \"stage stays put through the component steps\").toBe(1);\n219\t  }\n220\t\n221\t  const fit = await page.evaluate(() => ({ scrollW: document.documentElement.scrollWidth, w: innerWidth, h: innerHeight, stage: document.querySelector(\".story .stage\").getBoundingClientRect().height }));\n222\t  expect(fit.scrollW, \"no horizontal scroll\").toBeLessThanOrEqual(fit.w);\n223\t  expect(fit.stage, \"stage fits the viewport height\").toBeLessThanOrEqual(fit.h);\n224\t  expect(errors).toEqual([]);\n225\t});\n226\t// Shared by the e2e specs.\n227\texport function watchErrors(page) {\n228\t  const errors = [];\n229\t  page.on(\"pageerror\", e => errors.push(`pageerror: ${e.message}`));\n230\t  page.on(\"console\", m => { if (m.type() === \"error\") errors.push(`console: ${m.text()}`); });\n231\t  return errors;\n232\t}\n233\t\n234\t// What each step of a car's story (lib/app/story.js) puts on the stage: intro on the photo, one step per component in 3D,\n235\t// background on the photo with the car outline. A car without a photo shows its model instead (lib/app/viewer.js).\n236\texport const stepsOf = car => {\n237\t  const first = car.components[0].id, photo = car.photo ? \"photo\" : \"model\";\n238\t  return [{ comp: first, view: photo, outline: false }, ...car.components.map(c => ({ comp: c.id, view: \"model\", outline: false })), { comp: first, view: photo, outline: true }];\n239\t};\n240\t\n241\t// The page's ?debug handle for story i: the step at the reading line and what the stage shows.\n242\texport const shown = (page, i = 0) => page.evaluate(i => ({ step: window.__tour.stories[i].step(), state: window.__tour.stories[i].state() }), i);\n243\t// After one visit with signal every stop works with no network (Chromium: Playwright's SW support is reliable there).\n244\timport { test, expect } from \"@playwright/test\";\n245\timport tour from \"../../stops/tour.js\";\n246\t\n247\ttest(\"one visit stores the whole tour; another stop then opens offline\", async ({ page, context }) => {\n248\t  await page.goto(\"./?sw=1\");   // service worker is skipped on localhost unless asked for\n249\t  await expect(page.locator(\"#status\")).toContainText(\"Ready offline\", { timeout: 30_000 });\n250\t  await context.setOffline(true);\n251\t  const slug = tour.at(-1).slug;\n252\t  await page.goto(`stop.html?s=${slug}&sw=1&debug`);\n253\t  await page.waitForFunction(() => window.__tour?.stories[0].frames() > 5, null, { timeout: 20_000 });\n254\t  await page.goto(\"./?sw=1\");\n255\t  await expect(page.locator('a[href^=\"stop.html?s=\"]')).toHaveCount(tour.length);\n256\t  await page.goto(\"teaser.html?sw=1\");\n257\t  await expect(page.locator('a[href^=\"stop.html?s=\"]')).toHaveCount(3);\n258\t});\n259\t// Every stop on the route is wired up: config present, subsystems resolve, photos and credits exist, talk points written.\n260\timport { test } from \"node:test\";\n261\timport assert from \"node:assert/strict\";\n262\timport { existsSync } from \"node:fs\";\n263\timport { tour, loadCars } from \"./helpers.mjs\";\n264\timport { teaser } from \"../../stops/tour.js\";\n265\t\n266\tconst root = new URL(\"../../\", import.meta.url);\n267\tconst exists = p => existsSync(new URL(p, root));\n268\tconst cars = await loadCars();\n269\t\n270\ttest(\"tour slugs are unique, safe and match their config\", () => {\n271\t  assert.equal(new Set(tour.map(s => s.slug)).size, tour.length);\n272\t  tour.forEach((s, i) => {\n273\t    assert.match(s.slug, /^[a-z0-9-]+$/);\n274\t    assert.equal(cars[i].slug, s.slug);\n275\t    assert.ok(s.room && Number.isInteger(s.level), `${s.slug}: room and level`);\n276\t    assert.ok(s.check === undefined || [\"room\", \"level\"].includes(s.check), `${s.slug}: check is \"room\" or \"level\"`);\n277\t  });\n278\t});\n279\t\n280\ttest(\"the teaser is three distinct stops of the tour\", () => {\n281\t  assert.equal(new Set(teaser).size, 3);\n282\t  for (const slug of teaser) assert.ok(tour.some(s => s.slug === slug), slug);\n283\t});\n284\t\n285\tfor (const car of cars) {\n286\t  test(`${car.slug}: text, components and sources`, () => {\n287\t    for (const k of [\"title\", \"name\", \"summary\", \"eyebrow\", \"lede\", \"note\"]) assert.ok(car[k], `${k} missing`);\n288\t    assert.ok(Number.isInteger(car.year));\n289\t    assert.ok(car.components.length > 0);\n290\t    assert.equal(new Set(car.components.map(c => c.id)).size, car.components.length, \"component ids unique\");\n291\t    for (const k of [\"question\", \"look\", \"takeaway\"]) assert.ok(car[k] === undefined || car[k].length > 10, `${k}: a sentence`);\n292\t    for (const c of car.components) {\n293\t      for (const k of [\"prompt\", \"answer\", \"more\"]) assert.ok(c[k] === undefined || c[k].length > 5, `${c.id}.${k}: text`);\n294\t      assert.ok(!c.answer || c.prompt, `${c.id}: an answer needs its prompt`);\n295\t      assert.match(c.subsystem, /^[a-z0-9-]+$/);\n296\t      assert.ok(exists(`subsystems/${c.subsystem}.js`), `subsystems/${c.subsystem}.js`);\n297\t      assert.ok(c.label && c.view?.pos?.length === 3 && c.view?.target?.length === 3, `${c.id}: label and view`);\n298\t      assert.ok(c.talk?.length > 0 && c.talk.every(t => t.length > 20), `${c.id}: talk points`);\n299\t      if (c.real) {   // the real part: a shared photo under parts/, with its size, words and credit\n300\t        assert.match(c.real.src, /^parts\\/[a-z0-9-]+\\.jpg$/); assert.ok(exists(c.real.src), `${c.id}: ${c.real.src}`);\n301\t        assert.ok(c.real.w > 0 && c.real.h > 0 && c.real.alt && c.real.caption?.length > 20, `${c.id}: real size and text`);\n302\t        assert.ok(c.real.credit?.author && c.real.credit.license && /^https:\\/\\//.test(c.real.credit.url), `${c.id}: real credit`);\n303\t      }\n304\t    }\n305\t    assert.ok(Array.isArray(car.unverified) && Array.isArray(car.sources));\n306\t    for (const s of car.sources) assert.match(s.url, /^https:\\/\\//);\n307\t  });\n308\t\n309\t  if (car.photo) test(`${car.slug}: photo, camera fit and credit`, () => {\n310\t    assert.ok(exists(`stops/${car.slug}/${car.photo.src}`), \"photo file\");\n311\t    assert.ok(car.photo.w > 0 && car.photo.h > 0 && car.photo.alt);\n312\t    assert.ok([\"c\", \"yaw\", \"pitch\", \"roll\", \"f\"].every(k => k in car.photo.cam));\n313\t    assert.ok(car.photo.credit?.author && car.photo.credit.license && car.photo.credit.url);\n314\t  });\n315\t}\n316\t// Shared test helpers: load the tour and every car config (pure data, no three.js).\n317\timport tour from \"../../stops/tour.js\";\n318\t\n319\texport { tour };\n320\texport const loadCars = () => Promise.all(tour.map(async s => (await import(`../../stops/${s.slug}/car.js`)).default));\n321\t\n322\t// The car.js fields a translation overlay (stops/<slug>/<lang>.js) must cover: page text and the labels subsystems show.\n323\t// Paths use \"*\" for any array index; legend entries are [token, text] pairs, so only their text is translated.\n324\tconst TEXT = [\n325\t  \"title\", \"name\", \"summary\", \"eyebrow\", \"lede\", \"note\", \"unverified.*\", \"photo.alt\",\n326\t  \"question\", \"look\", \"takeaway\", \"photo.caption\",\n327\t  \"components.*.label\", \"components.*.talk.*\", \"components.*.prompt\", \"components.*.answer\", \"components.*.more\",\n328\t  \"components.*.real.alt\", \"components.*.real.caption\",\n329\t  ...[\"label\", \"engineLabel\", \"legendTitle\", \"links.*.name\", \"shapes.*.label\", \"types.*.label\", \"presets.*.label\",\n330\t    \"cases.*.label\", \"cases.*.say\", \"modes.*\", \"drive.gears.*.name\", \"legend.*.1\", \"surfaces.*.label\",\n331\t    \"consumers.*.label\", \"compare\"].map(p => `components.*.params.${p}`),\n332\t];\n333\tconst RULES = TEXT.map(p => new RegExp(`^${p.replace(/\\./g, \"\\\\.\").replace(/\\*/g, \"[^.]+\")}$`));\n334\texport const isText = path => RULES.some(r => r.test(path));\n335\t\n336\t// Every string leaf of v as [path, value], path joined with \".\".\n337\texport function leaves(v, path = []) {\n338\t  if (typeof v === \"string\") return [[path.join(\".\"), v]];\n339\t  if (Array.isArray(v)) return v.flatMap((x, i) => leaves(x, [...path, i]));\n340\t  if (v && typeof v === \"object\") return Object.entries(v).flatMap(([k, x]) => leaves(x, [...path, k]));\n341\t  return [];\n342\t}\n343\t\n344\t// The overlay shape for a car with only its text leaves; other array items become null (merge keeps the original).\n345\texport function skeleton(v, path = []) {\n346\t  if (typeof v === \"string\") return isText(path.join(\".\")) ? v : undefined;\n347\t  if (Array.isArray(v)) {\n348\t    const items = v.map((x, i) => skeleton(x, [...path, i]));\n349\t    return items.some(x => x !== undefined) ? items.map(x => x ?? null) : undefined;\n350\t  }\n351\t  if (v && typeof v === \"object\") {\n352\t    const out = {};\n353\t    for (const [k, x] of Object.entries(v)) { const s = skeleton(x, [...path, k]); if (s !== undefined) out[k] = s; }\n354\t    return Object.keys(out).length ? out : undefined;\n355\t  }\n356\t  return undefined;\n357\t}\n358\t// Translations: the UI catalog holds exactly the keys the code uses, with matching {n} placeholders; subsystem text goes\n359\t// through t(); every stop's stops/<slug>/hu.js covers exactly the text fields of its car.js.\n360\timport test from \"node:test\";\n361\timport assert from \"node:assert/strict\";\n362\timport { readFileSync, readdirSync } from \"node:fs\";\n363\timport { tour, loadCars, leaves, isText } from \"./helpers.mjs\";\n364\timport { merge } from \"../../lib/app/i18n.js\";\n365\timport hu from \"../../lib/app/i18n/hu.js\";\n366\t\n367\tconst root = new URL(\"../../\", import.meta.url);\n368\tconst read = p => readFileSync(new URL(p, root), \"utf8\");\n369\tconst js = dir => readdirSync(new URL(dir, root)).filter(f => f.endsWith(\".js\")).map(f => [`${dir}${f}`, read(`${dir}${f}`)]);\n370\tconst code = s => s.replace(/^\\s*\\/\\/.*$/gm, \"\").replace(/\\s\\/\\/ .*$/gm, \"\");   // comments may quote t(\"…\")\n371\tconst sources = [...js(\"lib/app/\"), ...js(\"subsystems/\")].filter(([f]) => f !== \"lib/app/i18n.js\").map(([f, s]) => [f, code(s)]);\n372\t\n373\tconst used = new Set();\n374\tfor (const [, s] of sources) for (const m of s.matchAll(/\\bt\\(\\s*\"((?:[^\"\\\\]|\\\\.)*)\"/g)) used.add(JSON.parse(`\"${m[1]}\"`));\n375\tfor (const f of readdirSync(root).filter(f => f.endsWith(\".html\"))) for (const m of read(f).matchAll(/data-i18n[^>]*>([^<]*)</g)) used.add(m[1].trim().replace(/\\s+/g, \" \"));\n376\tfor (const s of tour) used.add(s.room);   // shown with t(stop.room)\n377\t\n378\ttest(\"every text the code shows has a Hungarian translation\", () => {\n379\t  assert.deepEqual([...used].filter(k => !(k in hu)), []);\n380\t  assert.deepEqual([...used].filter(k => k.includes(\"&\")), [], \"data-i18n text is read as textContent: write characters, not entities\");\n381\t});\n382\t\n383\ttest(\"the Hungarian catalog has no unused keys\", () => {\n384\t  assert.deepEqual(Object.keys(hu).filter(k => !used.has(k)), []);\n385\t});\n386\t\n387\ttest(\"translations keep their {n} placeholders\", () => {\n388\t  const marks = s => [...s.matchAll(/\\{\\d\\}/g)].map(m => m[0]).sort().join();\n389\t  assert.deepEqual(Object.entries(hu).filter(([k, v]) => marks(k) !== marks(v)).map(([k]) => k), []);\n390\t});\n391\t\n392\ttest(\"t() is called with a literal, so the tests can find every key\", () => {\n393\t  const bad = [];\n394\t  for (const [f, s] of sources) for (const m of s.matchAll(/\\bt\\(\\s*([^\\s\"])/g)) {\n395\t    const call = s.slice(m.index, m.index + 20);\n396\t    if (!/^t\\((stop\\.room|room\\.name)\\)/.test(call)) bad.push(`${f}: ${call}`);   // rooms: keys taken from stops/tour.js\n397\t  }\n398\t  assert.deepEqual(bad, []);\n399\t});\n400\t\n401\ttest(\"subsystem labels, units and legends go through t()\", () => {\n402\t  const bad = [];\n403\t  for (const [f, s] of sources.filter(([f]) => f.startsWith(\"subsystems/\"))) {\n404\t    for (const m of s.matchAll(/\\b(?:label|unit|text|aria|top|bottom): \"[^\"]*[A-Za-z][^\"]*\"|toggle: \\[\"|\\[\"--[a-z0-9-]+\", \"[^\"]*[A-Za-z]/g)) bad.push(`${f}: ${m[0]}`);\n405\t  }\n406\t  assert.deepEqual(bad, []);\n407\t});\n408\t\n409\tconst cars = await loadCars();\n410\tfor (const [i, s] of tour.entries()) {\n411\t  test(`${s.slug}: hu.js translates every text field of car.js and nothing else`, async () => {\n412\t    const car = cars[i], over = (await import(`../../stops/${s.slug}/hu.js`)).default;\n413\t    const text = new Map(leaves(car).filter(([p]) => isText(p))), got = new Map(leaves(over));\n414\t    assert.deepEqual([...text.keys()].filter(p => !got.get(p)?.trim()), [], \"untranslated\");\n415\t    assert.deepEqual([...got.keys()].filter(p => !text.has(p)), [], \"not a text field of car.js\");\n416\t    assert.deepEqual(leaves(merge(car, over)).filter(([p]) => !isText(p)), leaves(car).filter(([p]) => !isText(p)));\n417\t    // Hungarian writes a decimal comma; model names such as \"300 SEL 6.3\" or \"190 E 2.5-16\" keep their point.\n418\t    assert.deepEqual([...got.values()].filter(v => /\\d\\.\\d/.test(v.replace(/SEL 6\\.3|SLC 5\\.0|\\b2\\.[35]-16/g, \"\"))), [], \"decimal point\");\n419\t  });\n420\t}\n421\t// Lattice-Boltzmann wind tunnel (lib/model/flow.js) and the flow configs that use it.\n422\timport { test } from \"node:test\";\n423\timport assert from \"node:assert/strict\";\n424\timport { rasterize, createTunnel } from \"../../lib/model/flow.js\";\n425\timport { loadCars } from \"./helpers.mjs\";\n426\t\n427\ttest(\"flow: an empty tunnel keeps the uniform stream (the road moves with the air)\", () => {\n428\t  const t = createTunnel({ nx: 40, nz: 20, solid: new Uint8Array(800), U: 0.1 });\n429\t  for (let s = 0; s < 200; s++) t.step();\n430\t  for (let c = 0; c < 800; c++) {\n431\t    assert.ok(Math.abs(t.ux[c] - 0.1) < 1e-4 && Math.abs(t.uz[c]) < 1e-4, `cell ${c}: ${t.ux[c]}, ${t.uz[c]}`);\n432\t    assert.ok(Math.abs(t.rho[c] - 1) < 1e-4);\n433\t  }\n434\t});\n435\t\n436\ttest(\"flow: a block on stilts stops the air at its nose, speeds it over the top and leaves a slow wake\", () => {\n437\t  // 200 × 100 mm cells; block 1.2 m long, 0.4–1.2 m high, front at x = 0. Tunnel from x = 2 m to −8 m, 3 m tall.\n438\t  const block = [[0, 400], [0, 1200], [-1200, 1200], [-1200, 400]];\n439\t  const { nx, nz, solid } = rasterize(block, { x0: 2000, x1: -8000, top: 3000, cell: 100 });\n440\t  assert.equal(nx, 100); assert.equal(nz, 30);\n441\t  assert.equal(solid.reduce((a, b) => a + b, 0), 12 * 8, \"12 × 8 cells\");\n442\t  const t = createTunnel({ nx, nz, solid, U: 0.1, nu: 0.004 });   // viscous enough to settle to a steady picture\n443\t  for (let s = 0; s < 4000; s++) t.step();\n444\t  const at = (x, z) => Math.round((2000 - x) / 100 - 0.5) + nx * Math.round(z / 100 - 0.5);\n445\t  for (let c = 0; c < nx * nz; c++) assert.ok(Number.isFinite(t.ux[c]) && Number.isFinite(t.rho[c]), \"stays finite\");\n446\t  assert.ok(t.cp(at(50, 800)) > 0.6, `stagnation at the nose: Cp ${t.cp(at(50, 800)).toFixed(2)}`);\n447\t  assert.ok(t.cp(at(50, 800)) < 1.2, \"no more than the stream's dynamic pressure (allowing for blockage)\");\n448\t  assert.ok(t.ux[at(-600, 1650)] > 0.11, \"faster than the stream over the top (outside the separation bubble)\");\n449\t  let wake = 0; for (let z = 450; z < 1200; z += 100) wake += t.ux[at(-1450, z)] / 8;\n450\t  assert.ok(wake < 0.05, `slow (or reversed) air right behind the block: ${wake.toFixed(3)}`);\n451\t  assert.ok(t.cp(at(-1250, 800)) < 0, \"suction on the back face\");\n452\t  const d = { total: 0, push: 0, suction: 0 };\n453\t  for (let s = 0; s < 500; s++) { t.step(); for (const k in d) d[k] += t.drag[k] / 500; }\n454\t  assert.ok(d.push > 0 && d.suction > 0, \"the nose is pushed and the back sucked, both backwards\");\n455\t  assert.ok(d.push + d.suction > 0.8 * d.total, `a bluff block's drag is mostly pressure: ${JSON.stringify(d)}`);\n456\t  const cd = d.total / (0.5 * 0.1 * 0.1 * 8);   // per unit span over the 8-cell frontal height\n457\t  assert.ok(cd > 1 && cd < 5, `2-D block (blockage raises it above ~2) drag coefficient ${cd.toFixed(2)}`);\n458\t});\n459\t\n460\ttest(\"every flow config has a closed tunnel around its profile and runs stably\", async () => {\n461\t  for (const c of await loadCars()) for (const comp of c.components.filter(k => k.params.flow))\n462\t  for (const profile of new Set([comp.params.flow.profile, ...comp.params.shapes.map(s => s.profile).filter(Boolean)])) {\n463\t    const F = { ...comp.params.flow, profile, ground: comp.params.ground ?? 0 }, grid = rasterize(profile, F), { nx, nz, solid } = grid;\n464\t    assert.ok(nx * nz <= 17000, `${c.slug}: ${nx * nz} cells, over the iPhone budget`);\n465\t    for (let i = 0; i < nx; i++) assert.equal(solid[(nz - 1) * nx + i], 0, `${c.slug}: body reaches the tunnel top`);\n466\t    for (let j = 0; j < nz; j++) assert.equal(solid[j * nx] + solid[j * nx + nx - 1], 0, `${c.slug}: body reaches the inlet or outlet`);\n467\t    assert.ok(solid.reduce((a, b) => a + b, 0) > 50, `${c.slug}: body has cells`);\n468\t    const t = createTunnel(grid);\n469\t    for (let s = 0; s < 1500; s++) t.step();\n470\t    for (let k = 0; k < nx * nz; k++) assert.ok(Number.isFinite(t.ux[k]) && Math.abs(t.rho[k] - 1) < 0.2, `${c.slug}: unstable at cell ${k}`);\n471\t  }\n472\t});\n473\t"}]},"uuid":"16d6708b-32c2-403e-9048-8f7bbecea604","timestamp":"2026-11-25T20:57:49.841Z","toolUseResult":{"type":"text","file":{"filePath":"/private/tmp/claude-501/-Users-kunabel-workspace-MercedesExperience/5216a6b1-4da7-448e-be48-b0eb888aff5f/scratchpad/r2.txt","content":"// Every stop on the route loads, renders and animates, and scrolling its story sets what the stage shows, on each emulated\n// device.\nimport { test, expect } from \"@playwright/test\";\nimport tour, { teaser } from \"../../stops/tour.js\";\nimport { watchErrors, stepsOf, shown } from \"./helpers.mjs\";\n\nconst cars = await Promise.all(tour.map(async s => (await import(`../../stops/${s.slug}/car.js`)).default));\n\nfor (const car of cars) {\n  test(`${car.slug}: the story's steps set the stage, readouts move`, async ({ page }) => {\n    const errors = watchErrors(page);\n    await page.goto(`stop.html?s=${car.slug}&debug`);\n    await page.waitForFunction(() => window.__tour?.stories[0].frames() > 10, null, { timeout: 20_000 });\n    await expect(page.locator(\".step\")).toHaveCount(car.components.length + 2);\n\n    const pinned = new Set();\n    for (const [k, want] of stepsOf(car).entries()) {\n      const step = page.locator(\".step\").nth(k);\n      await step.evaluate(s => s.scrollIntoView({ block: \"center\" }));\n      await expect.poll(() => shown(page)).toEqual({ step: k, state: want });\n      await expect(page.locator(\".stage img\")).toBeVisible({ visible: want.view === \"photo\" });\n      if (k === 0 || k > car.components.length) continue;   // intro and background: no component cards\n      pinned.add(await page.locator(\".stage\").evaluate(s => Math.round(s.getBoundingClientRect().top)));\n      await expect.poll(() => page.evaluate(() => window.__tour.stories[0].triangles())).toBeGreaterThan(0);\n      const readouts = () => step.locator(`.panel[data-comp=\"${want.comp}\"] output`).allTextContents();\n      const before = await readouts();\n      expect(before.length).toBeGreaterThan(0);\n      // Precomputed results (race-aero) stand still until another case is chosen: press the first case button (race-aero starts\n      // on a later one; animated components move either way).\n      if (car.components.find(c => c.id === want.comp).params.cases) await step.locator(`.panel[data-comp=\"${want.comp}\"] button`).first().click();\n      await expect.poll(readouts, { timeout: 15_000 }).not.toEqual(before);\n    }\n    expect(pinned.size, \"stage stays put through the component steps\").toBe(1);\n\n    const fit = await page.evaluate(() => ({ scrollW: document.documentElement.scrollWidth, w: innerWidth, h: innerHeight, stage: document.querySelector(\".stage\").getBoundingClientRect().height }));\n    expect(fit.scrollW, \"no horizontal scroll\").toBeLessThanOrEqual(fit.w);\n    expect(fit.stage, \"stage fits the viewport height\").toBeLessThanOrEqual(fit.h);\n    expect(errors).toEqual([]);\n  });\n}\n\ntest(\"index lists every stop in walking order\", async ({ page }) => {\n  const errors = watchErrors(page);\n  await page.goto(\"./\");\n  const links = page.locator('a[href^=\"stop.html?s=\"]');\n  await expect(links).toHaveCount(tour.length);\n  expect(await links.evaluateAll(as => as.map(a => new URL(a.href).searchParams.get(\"s\")))).toEqual(tour.map(s => s.slug));\n  expect(errors).toEqual([]);\n});\n\ntest(\"index: room jump links reach their rooms; highlights and back again\", async ({ page }) => {\n  const errors = watchErrors(page);\n  await page.goto(\"./\");\n  const jumps = page.locator(\".jump a\");\n  await expect(jumps).toHaveCount(new Set(tour.map(s => `${s.room} ${s.level}`)).size);\n  for (const href of await jumps.evaluateAll(as => as.map(a => a.getAttribute(\"href\")))) await expect(page.locator(href)).toHaveClass(\"room\");\n  await page.locator('.jump a[href=\"#room-legend-6\"]').click();\n  await expect(page.locator(\"#room-legend-6 h2\")).toBeInViewport();\n  await page.getByRole(\"link\", { name: \"Three highlights\" }).click();\n  await expect(page).toHaveURL(/teaser\\.html$/);\n  await expect(page.getByRole(\"link\", { name: \"See the full route\" })).toHaveAttribute(\"href\", \"./#jump\");\n  expect(errors).toEqual([]);\n});\n\ntest(\"index: “Find your room” and a fresh ./#jump both bring the room picker into view\", async ({ page }) => {\n  const errors = watchErrors(page);\n  await page.goto(\"./\");\n  await expect(page.locator(\".jump a\").first()).toBeVisible();\n  await page.getByRole(\"link\", { name: \"Find your room\" }).click();\n  await expect(page.locator(\"#jump-title\")).toBeInViewport();\n  await expect(page.locator(\".jump a\").first()).toBeInViewport();\n  await page.goto(\"about:blank\");\n  await page.goto(\"./#jump\");\n  await expect(page.locator(\".jump a\").first()).toBeInViewport();\n  await expect(page.locator(\"#jump-title\")).toBeInViewport();\n  expect(errors).toEqual([]);\n});\n\nfor (const lang of [\"en\", \"hu\"]) {\n  test(`SLK roof steps (${lang}): every label fits its cell and names the movement in either direction`, async ({ page }) => {\n    const errors = watchErrors(page);\n    await page.addInitScript(l => localStorage.setItem(\"tour-lang\", l), lang);\n    await page.goto(\"stop.html?s=slk&debug\");\n    await page.waitForFunction(() => window.__tour?.stories[0].frames() > 2, null, { timeout: 20_000 });\n    const step = page.locator(\".step\").nth(1);\n    await step.evaluate(s => s.scrollIntoView({ block: \"center\" }));\n    const cells = step.locator(\".cyls .cyl\");\n    await expect(cells).toHaveCount(4);\n    const labels = () => cells.locator(\"b\").allTextContents();\n    const overflowing = () => cells.evaluateAll(cs => cs.filter(c => c.scrollWidth > c.clientWidth).map(c => c.firstChild.textContent));\n    const buttons = step.locator(\".row\").first().locator(\"button\");\n    await buttons.nth(0).click();   // Open the roof\n    expect(await labels()).toEqual(lang === \"en\" ? [\"Unlatch\", \"Boot lid up\", \"Roof folds back\", \"Boot lid down\"] : [\"Reteszoldás\", \"Fedél nyílik\", \"A tető hátrahajlik\", \"Fedél zárul\"]);\n    expect(await overflowing()).toEqual([]);\n    await buttons.nth(1).click();   // Close the roof\n    await expect.poll(labels).toEqual(lang === \"en\" ? [\"Boot lid up\", \"Roof folds forward\", \"Boot lid down\", \"Latch\"] : [\"Fedél nyílik\", \"A tető előrehajlik\", \"Fedél zárul\", \"Reteszelés\"]);\n    expect(await overflowing()).toEqual([]);\n    expect(errors).toEqual([]);\n  });\n}\n\ntest(\"switching language keeps the experiment: the 300 SL's lowered frame stays chosen and in view\", async ({ page }) => {\n  const errors = watchErrors(page);\n  await page.addInitScript(() => { if (!localStorage.getItem(\"tour-lang\")) localStorage.setItem(\"tour-lang\", \"en\"); });\n  await page.goto(\"stop.html?s=300sl&debug\");\n  await page.waitForFunction(() => window.__tour?.stories[0].frames() > 2, null, { timeout: 20_000 });\n  await page.locator(\".step\").nth(1).evaluate(s => s.scrollIntoView({ block: \"center\" }));\n  await expect.poll(() => shown(page)).toMatchObject({ step: 1, state: { comp: \"frame\" } });\n  await page.getByRole(\"button\", { name: \"Lower sill for conventional doors\" }).click();\n  for (const [to, lower] of [[\"Magyar\", \"Alacsony küszöb hagyományos ajtóhoz\"], [\"English\", \"Lower sill for conventional doors\"]]) {\n    await page.getByRole(\"button\", { name: to }).click();\n    await page.waitForFunction(() => window.__tour?.stories[0].frames() > 2, null, { timeout: 20_000 });\n    const button = page.getByRole(\"button\", { name: lower });\n    await expect(button).toHaveAttribute(\"aria-pressed\", \"true\");\n    await expect(button).toBeInViewport();\n    await expect.poll(() => shown(page)).toMatchObject({ step: 1, state: { comp: \"frame\" } });\n  }\n  expect(errors).toEqual([]);\n});\n\ntest(\"the stop's photo, credit and introduction show even when 3D cannot load\", async ({ page }) => {\n  await page.route(/vendor\\/three\\//, r => r.abort());\n  await page.goto(\"stop.html?s=slk\");\n  await expect(page.locator(\".story-stage .fail\")).toBeVisible();\n  await expect(page.locator(\".stage img\")).toBeVisible();\n  await expect(page.locator(\".stage .credit\")).toBeVisible();\n  await expect(page.locator(\".stage .caption\")).toHaveText(\"Reference photo of the same generation, not the museum's car\");\n  await expect(page.locator(\"h1\")).toBeVisible();\n  await expect(page.locator(\".step .look\").first()).toBeVisible();\n});\n\ntest(\"a real-part photo swaps places with the stage; a tap on the 3D view or scrolling away swaps them back\", async ({ page }) => {\n  const errors = watchErrors(page);\n  await page.goto(\"stop.html?s=540k&debug\");\n  await page.waitForFunction(() => window.__tour?.stories[0].frames() > 2, null, { timeout: 20_000 });\n  const swapped = () => page.evaluate(() => window.__tour.stories[0].swapped());\n  const pane = page.locator(\".story-stage\"), fig = page.locator(\"figure.real\").first();\n  // The photo just below the pinned stage, as a visitor sees it before tapping.\n  await page.evaluate(() => scrollBy(0, document.querySelector(\"figure.real\").getBoundingClientRect().top - document.querySelector(\".story-stage\").getBoundingClientRect().height - 20));\n  const height = (await pane.boundingBox()).height;\n\n  await fig.locator(\".real-open\").click();\n  expect(await swapped()).toBe(true);\n  await expect(pane.locator(\".real-open img\")).toBeVisible();\n  await expect(fig.locator(\".stage canvas\")).toBeVisible();\n  expect((await pane.boundingBox()).height, \"the pinned area keeps its size\").toBeCloseTo(height, 0);\n\n  const box = await fig.locator(\".stage\").boundingBox();\n  await page.mouse.click(box.x + box.width / 2, box.y + box.height / 2);\n  expect(await swapped()).toBe(false);\n  await expect(pane.locator(\".stage canvas\")).toBeVisible();\n\n  await fig.locator(\".real-open\").click();\n  await pane.locator(\".real-open\").click();   // the big photo swaps back too\n  expect(await swapped()).toBe(false);\n\n  await fig.locator(\".real-open\").click();\n  await page.evaluate(() => scrollBy(0, 2 * innerHeight));\n  await expect.poll(swapped).toBe(false);\n  await expect(pane.locator(\":scope > .stage\")).toHaveCount(1);\n  expect(errors).toEqual([]);\n});\n\ntest(\"unknown stop shows the not-found message and loads no 3D code\", async ({ page }) => {\n  const three = [];\n  page.on(\"request\", r => { if (/vendor\\/three|subsystems\\//.test(r.url())) three.push(r.url()); });\n  await page.goto(\"stop.html?s=../../etc\");\n  await expect(page.getByRole(\"heading\", { name: \"Stop not found\" })).toBeVisible();\n  expect(three).toEqual([]);\n});\n\ntest(\"teaser lists its three stops; opened from there, they page between each other\", async ({ page }) => {\n  const errors = watchErrors(page);\n  const order = tour.filter(s => teaser.includes(s.slug)).map(s => s.slug), href = s => `stop.html?s=${s}&r=teaser`;\n  await page.goto(\"teaser.html?debug\");\n  await page.waitForLoadState(\"networkidle\");   // leaving mid-load aborts imports\n  const links = page.locator('a[href^=\"stop.html?s=\"]');\n  await expect(links).toHaveCount(3);\n  expect(await links.evaluateAll(as => as.map(a => a.getAttribute(\"href\")))).toEqual(order.map(href));\n\n  for (const [i, slug] of order.entries()) {\n    await page.goto(`${href(slug)}&debug`);\n    await page.waitForFunction(() => window.__tour?.stories[0].frames() > 5, null, { timeout: 20_000 });   // leaving mid-load aborts imports\n    await expect(page.locator(\"#where\")).toContainText(`Stop ${i + 1} of 3`);\n    await expect(page.getByRole(\"link\", { name: \"← Highlights\" })).toHaveAttribute(\"href\", \"teaser.html\");\n    const pager = await page.locator(\".pager a\").evaluateAll(as => as.map(a => a.getAttribute(\"href\")));\n    expect(pager).toEqual([order[i - 1], order[i + 1]].filter(Boolean).map(href));\n  }\n\n  const other = tour.find(s => !teaser.includes(s.slug)).slug;   // not a teaser stop: the full tour's paging\n  await page.goto(`stop.html?s=${other}&r=teaser&debug`);\n  await page.waitForFunction(() => window.__tour?.stories[0].frames() > 5, null, { timeout: 20_000 });\n  await expect(page.locator(\"#where\")).toContainText(`of ${tour.length}`);\n  await expect(page.getByRole(\"link\", { name: \"← Tour route\" })).toHaveAttribute(\"href\", \"./\");\n  expect(errors).toEqual([]);\n});\n\ntest(\"teaser: each car's stage stays pinned while its steps scroll past and set what it shows\", async ({ page }) => {\n  const errors = watchErrors(page);\n  await page.goto(\"teaser.html?debug\");\n  await page.waitForFunction(() => window.__tour?.ready, null, { timeout: 30_000 });\n  const frames = () => page.evaluate(() => window.__tour.stories.map(s => s.frames()));\n\n  for (const [i, car] of cars.filter(c => teaser.includes(c.slug)).entries()) {\n    const el = page.locator(\".story\").nth(i), steps = stepsOf(car);\n    await expect(el.locator(\".step\")).toHaveCount(steps.length);\n    const pinned = new Set();\n    for (const [k, want] of steps.entries()) {\n      await el.locator(\".step\").nth(k).evaluate(s => s.scrollIntoView({ block: \"center\" }));\n      await expect.poll(() => shown(page, i)).toEqual({ step: k, state: want });\n      if (want.view !== \"model\") continue;\n      pinned.add(await el.locator(\".stage\").evaluate(s => Math.round(s.getBoundingClientRect().top)));\n      if (k > 1) continue;   // on the first component: only this car's stage animates\n      await page.waitForTimeout(300);\n      const f0 = await frames(); await page.waitForTimeout(600); const f1 = await frames();\n      expect(f1.map((f, j) => f > f0[j]), \"animating stages\").toEqual(f1.map((_, j) => j === i));\n    }\n    expect(pinned.size, \"stage stays put through the component steps\").toBe(1);\n  }\n\n  const fit = await page.evaluate(() => ({ scrollW: document.documentElement.scrollWidth, w: innerWidth, h: innerHeight, stage: document.querySelector(\".story .stage\").getBoundingClientRect().height }));\n  expect(fit.scrollW, \"no horizontal scroll\").toBeLessThanOrEqual(fit.w);\n  expect(fit.stage, \"stage fits the viewport height\").toBeLessThanOrEqual(fit.h);\n  expect(errors).toEqual([]);\n});\n// Shared by the e2e specs.\nexport function watchErrors(page) {\n  const errors = [];\n  page.on(\"pageerror\", e => errors.push(`pageerror: ${e.message}`));\n  page.on(\"console\", m => { if (m.type() === \"error\") errors.push(`console: ${m.text()}`); });\n  return errors;\n}\n\n// What each step of a car's story (lib/app/story.js) puts on the stage: intro on the photo, one step per component in 3D,\n// background on the photo with the car outline. A car without a photo shows its model instead (lib/app/viewer.js).\nexport const stepsOf = car => {\n  const first = car.components[0].id, photo = car.photo ? \"photo\" : \"model\";\n  return [{ comp: first, view: photo, outline: false }, ...car.components.map(c => ({ comp: c.id, view: \"model\", outline: false })), { comp: first, view: photo, outline: true }];\n};\n\n// The page's ?debug handle for story i: the step at the reading line and what the stage shows.\nexport const shown = (page, i = 0) => page.evaluate(i => ({ step: window.__tour.stories[i].step(), state: window.__tour.stories[i].state() }), i);\n// After one visit with signal every stop works with no network (Chromium: Playwright's SW support is reliable there).\nimport { test, expect } from \"@playwright/test\";\nimport tour from \"../../stops/tour.js\";\n\ntest(\"one visit stores the whole tour; another stop then opens offline\", async ({ page, context }) => {\n  await page.goto(\"./?sw=1\");   // service worker is skipped on localhost unless asked for\n  await expect(page.locator(\"#status\")).toContainText(\"Ready offline\", { timeout: 30_000 });\n  await context.setOffline(true);\n  const slug = tour.at(-1).slug;\n  await page.goto(`stop.html?s=${slug}&sw=1&debug`);\n  await page.waitForFunction(() => window.__tour?.stories[0].frames() > 5, null, { timeout: 20_000 });\n  await page.goto(\"./?sw=1\");\n  await expect(page.locator('a[href^=\"stop.html?s=\"]')).toHaveCount(tour.length);\n  await page.goto(\"teaser.html?sw=1\");\n  await expect(page.locator('a[href^=\"stop.html?s=\"]')).toHaveCount(3);\n});\n// Every stop on the route is wired up: config present, subsystems resolve, photos and credits exist, talk points written.\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { existsSync } from \"node:fs\";\nimport { tour, loadCars } from \"./helpers.mjs\";\nimport { teaser } from \"../../stops/tour.js\";\n\nconst root = new URL(\"../../\", import.meta.url);\nconst exists = p => existsSync(new URL(p, root));\nconst cars = await loadCars();\n\ntest(\"tour slugs are unique, safe and match their config\", () => {\n  assert.equal(new Set(tour.map(s => s.slug)).size, tour.length);\n  tour.forEach((s, i) => {\n    assert.match(s.slug, /^[a-z0-9-]+$/);\n    assert.equal(cars[i].slug, s.slug);\n    assert.ok(s.room && Number.isInteger(s.level), `${s.slug}: room and level`);\n    assert.ok(s.check === undefined || [\"room\", \"level\"].includes(s.check), `${s.slug}: check is \"room\" or \"level\"`);\n  });\n});\n\ntest(\"the teaser is three distinct stops of the tour\", () => {\n  assert.equal(new Set(teaser).size, 3);\n  for (const slug of teaser) assert.ok(tour.some(s => s.slug === slug), slug);\n});\n\nfor (const car of cars) {\n  test(`${car.slug}: text, components and sources`, () => {\n    for (const k of [\"title\", \"name\", \"summary\", \"eyebrow\", \"lede\", \"note\"]) assert.ok(car[k], `${k} missing`);\n    assert.ok(Number.isInteger(car.year));\n    assert.ok(car.components.length > 0);\n    assert.equal(new Set(car.components.map(c => c.id)).size, car.components.length, \"component ids unique\");\n    for (const k of [\"question\", \"look\", \"takeaway\"]) assert.ok(car[k] === undefined || car[k].length > 10, `${k}: a sentence`);\n    for (const c of car.components) {\n      for (const k of [\"prompt\", \"answer\", \"more\"]) assert.ok(c[k] === undefined || c[k].length > 5, `${c.id}.${k}: text`);\n      assert.ok(!c.answer || c.prompt, `${c.id}: an answer needs its prompt`);\n      assert.match(c.subsystem, /^[a-z0-9-]+$/);\n      assert.ok(exists(`subsystems/${c.subsystem}.js`), `subsystems/${c.subsystem}.js`);\n      assert.ok(c.label && c.view?.pos?.length === 3 && c.view?.target?.length === 3, `${c.id}: label and view`);\n      assert.ok(c.talk?.length > 0 && c.talk.every(t => t.length > 20), `${c.id}: talk points`);\n      if (c.real) {   // the real part: a shared photo under parts/, with its size, words and credit\n        assert.match(c.real.src, /^parts\\/[a-z0-9-]+\\.jpg$/); assert.ok(exists(c.real.src), `${c.id}: ${c.real.src}`);\n        assert.ok(c.real.w > 0 && c.real.h > 0 && c.real.alt && c.real.caption?.length > 20, `${c.id}: real size and text`);\n        assert.ok(c.real.credit?.author && c.real.credit.license && /^https:\\/\\//.test(c.real.credit.url), `${c.id}: real credit`);\n      }\n    }\n    assert.ok(Array.isArray(car.unverified) && Array.isArray(car.sources));\n    for (const s of car.sources) assert.match(s.url, /^https:\\/\\//);\n  });\n\n  if (car.photo) test(`${car.slug}: photo, camera fit and credit`, () => {\n    assert.ok(exists(`stops/${car.slug}/${car.photo.src}`), \"photo file\");\n    assert.ok(car.photo.w > 0 && car.photo.h > 0 && car.photo.alt);\n    assert.ok([\"c\", \"yaw\", \"pitch\", \"roll\", \"f\"].every(k => k in car.photo.cam));\n    assert.ok(car.photo.credit?.author && car.photo.credit.license && car.photo.credit.url);\n  });\n}\n// Shared test helpers: load the tour and every car config (pure data, no three.js).\nimport tour from \"../../stops/tour.js\";\n\nexport { tour };\nexport const loadCars = () => Promise.all(tour.map(async s => (await import(`../../stops/${s.slug}/car.js`)).default));\n\n// The car.js fields a translation overlay (stops/<slug>/<lang>.js) must cover: page text and the labels subsystems show.\n// Paths use \"*\" for any array index; legend entries are [token, text] pairs, so only their text is translated.\nconst TEXT = [\n  \"title\", \"name\", \"summary\", \"eyebrow\", \"lede\", \"note\", \"unverified.*\", \"photo.alt\",\n  \"question\", \"look\", \"takeaway\", \"photo.caption\",\n  \"components.*.label\", \"components.*.talk.*\", \"components.*.prompt\", \"components.*.answer\", \"components.*.more\",\n  \"components.*.real.alt\", \"components.*.real.caption\",\n  ...[\"label\", \"engineLabel\", \"legendTitle\", \"links.*.name\", \"shapes.*.label\", \"types.*.label\", \"presets.*.label\",\n    \"cases.*.label\", \"cases.*.say\", \"modes.*\", \"drive.gears.*.name\", \"legend.*.1\", \"surfaces.*.label\",\n    \"consumers.*.label\", \"compare\"].map(p => `components.*.params.${p}`),\n];\nconst RULES = TEXT.map(p => new RegExp(`^${p.replace(/\\./g, \"\\\\.\").replace(/\\*/g, \"[^.]+\")}$`));\nexport const isText = path => RULES.some(r => r.test(path));\n\n// Every string leaf of v as [path, value], path joined with \".\".\nexport function leaves(v, path = []) {\n  if (typeof v === \"string\") return [[path.join(\".\"), v]];\n  if (Array.isArray(v)) return v.flatMap((x, i) => leaves(x, [...path, i]));\n  if (v && typeof v === \"object\") return Object.entries(v).flatMap(([k, x]) => leaves(x, [...path, k]));\n  return [];\n}\n\n// The overlay shape for a car with only its text leaves; other array items become null (merge keeps the original).\nexport function skeleton(v, path = []) {\n  if (typeof v === \"string\") return isText(path.join(\".\")) ? v : undefined;\n  if (Array.isArray(v)) {\n    const items = v.map((x, i) => skeleton(x, [...path, i]));\n    return items.some(x => x !== undefined) ? items.map(x => x ?? null) : undefined;\n  }\n  if (v && typeof v === \"object\") {\n    const out = {};\n    for (const [k, x] of Object.entries(v)) { const s = skeleton(x, [...path, k]); if (s !== undefined) out[k] = s; }\n    return Object.keys(out).length ? out : undefined;\n  }\n  return undefined;\n}\n// Translations: the UI catalog holds exactly the keys the code uses, with matching {n} placeholders; subsystem text goes\n// through t(); every stop's stops/<slug>/hu.js covers exactly the text fields of its car.js.\nimport test from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { readFileSync, readdirSync } from \"node:fs\";\nimport { tour, loadCars, leaves, isText } from \"./helpers.mjs\";\nimport { merge } from \"../../lib/app/i18n.js\";\nimport hu from \"../../lib/app/i18n/hu.js\";\n\nconst root = new URL(\"../../\", import.meta.url);\nconst read = p => readFileSync(new URL(p, root), \"utf8\");\nconst js = dir => readdirSync(new URL(dir, root)).filter(f => f.endsWith(\".js\")).map(f => [`${dir}${f}`, read(`${dir}${f}`)]);\nconst code = s => s.replace(/^\\s*\\/\\/.*$/gm, \"\").replace(/\\s\\/\\/ .*$/gm, \"\");   // comments may quote t(\"…\")\nconst sources = [...js(\"lib/app/\"), ...js(\"subsystems/\")].filter(([f]) => f !== \"lib/app/i18n.js\").map(([f, s]) => [f, code(s)]);\n\nconst used = new Set();\nfor (const [, s] of sources) for (const m of s.matchAll(/\\bt\\(\\s*\"((?:[^\"\\\\]|\\\\.)*)\"/g)) used.add(JSON.parse(`\"${m[1]}\"`));\nfor (const f of readdirSync(root).filter(f => f.endsWith(\".html\"))) for (const m of read(f).matchAll(/data-i18n[^>]*>([^<]*)</g)) used.add(m[1].trim().replace(/\\s+/g, \" \"));\nfor (const s of tour) used.add(s.room);   // shown with t(stop.room)\n\ntest(\"every text the code shows has a Hungarian translation\", () => {\n  assert.deepEqual([...used].filter(k => !(k in hu)), []);\n  assert.deepEqual([...used].filter(k => k.includes(\"&\")), [], \"data-i18n text is read as textContent: write characters, not entities\");\n});\n\ntest(\"the Hungarian catalog has no unused keys\", () => {\n  assert.deepEqual(Object.keys(hu).filter(k => !used.has(k)), []);\n});\n\ntest(\"translations keep their {n} placeholders\", () => {\n  const marks = s => [...s.matchAll(/\\{\\d\\}/g)].map(m => m[0]).sort().join();\n  assert.deepEqual(Object.entries(hu).filter(([k, v]) => marks(k) !== marks(v)).map(([k]) => k), []);\n});\n\ntest(\"t() is called with a literal, so the tests can find every key\", () => {\n  const bad = [];\n  for (const [f, s] of sources) for (const m of s.matchAll(/\\bt\\(\\s*([^\\s\"])/g)) {\n    const call = s.slice(m.index, m.index + 20);\n    if (!/^t\\((stop\\.room|room\\.name)\\)/.test(call)) bad.push(`${f}: ${call}`);   // rooms: keys taken from stops/tour.js\n  }\n  assert.deepEqual(bad, []);\n});\n\ntest(\"subsystem labels, units and legends go through t()\", () => {\n  const bad = [];\n  for (const [f, s] of sources.filter(([f]) => f.startsWith(\"subsystems/\"))) {\n    for (const m of s.matchAll(/\\b(?:label|unit|text|aria|top|bottom): \"[^\"]*[A-Za-z][^\"]*\"|toggle: \\[\"|\\[\"--[a-z0-9-]+\", \"[^\"]*[A-Za-z]/g)) bad.push(`${f}: ${m[0]}`);\n  }\n  assert.deepEqual(bad, []);\n});\n\nconst cars = await loadCars();\nfor (const [i, s] of tour.entries()) {\n  test(`${s.slug}: hu.js translates every text field of car.js and nothing else`, async () => {\n    const car = cars[i], over = (await import(`../../stops/${s.slug}/hu.js`)).default;\n    const text = new Map(leaves(car).filter(([p]) => isText(p))), got = new Map(leaves(over));\n    assert.deepEqual([...text.keys()].filter(p => !got.get(p)?.trim()), [], \"untranslated\");\n    assert.deepEqual([...got.keys()].filter(p => !text.has(p)), [], \"not a text field of car.js\");\n    assert.deepEqual(leaves(merge(car, over)).filter(([p]) => !isText(p)), leaves(car).filter(([p]) => !isText(p)));\n    // Hungarian writes a decimal comma; model names such as \"300 SEL 6.3\" or \"190 E 2.5-16\" keep their point.\n    assert.deepEqual([...got.values()].filter(v => /\\d\\.\\d/.test(v.replace(/SEL 6\\.3|SLC 5\\.0|\\b2\\.[35]-16/g, \"\"))), [], \"decimal point\");\n  });\n}\n// Lattice-Boltzmann wind tunnel (lib/model/flow.js) and the flow configs that use it.\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { rasterize, createTunnel } from \"../../lib/model/flow.js\";\nimport { loadCars } from \"./helpers.mjs\";\n\ntest(\"flow: an empty tunnel keeps the uniform stream (the road moves with the air)\", () => {\n  const t = createTunnel({ nx: 40, nz: 20, solid: new Uint8Array(800), U: 0.1 });\n  for (let s = 0; s < 200; s++) t.step();\n  for (let c = 0; c < 800; c++) {\n    assert.ok(Math.abs(t.ux[c] - 0.1) < 1e-4 && Math.abs(t.uz[c]) < 1e-4, `cell ${c}: ${t.ux[c]}, ${t.uz[c]}`);\n    assert.ok(Math.abs(t.rho[c] - 1) < 1e-4);\n  }\n});\n\ntest(\"flow: a block on stilts stops the air at its nose, speeds it over the top and leaves a slow wake\", () => {\n  // 200 × 100 mm cells; block 1.2 m long, 0.4–1.2 m high, front at x = 0. Tunnel from x = 2 m to −8 m, 3 m tall.\n  const block = [[0, 400], [0, 1200], [-1200, 1200], [-1200, 400]];\n  const { nx, nz, solid } = rasterize(block, { x0: 2000, x1: -8000, top: 3000, cell: 100 });\n  assert.equal(nx, 100); assert.equal(nz, 30);\n  assert.equal(solid.reduce((a, b) => a + b, 0), 12 * 8, \"12 × 8 cells\");\n  const t = createTunnel({ nx, nz, solid, U: 0.1, nu: 0.004 });   // viscous enough to settle to a steady picture\n  for (let s = 0; s < 4000; s++) t.step();\n  const at = (x, z) => Math.round((2000 - x) / 100 - 0.5) + nx * Math.round(z / 100 - 0.5);\n  for (let c = 0; c < nx * nz; c++) assert.ok(Number.isFinite(t.ux[c]) && Number.isFinite(t.rho[c]), \"stays finite\");\n  assert.ok(t.cp(at(50, 800)) > 0.6, `stagnation at the nose: Cp ${t.cp(at(50, 800)).toFixed(2)}`);\n  assert.ok(t.cp(at(50, 800)) < 1.2, \"no more than the stream's dynamic pressure (allowing for blockage)\");\n  assert.ok(t.ux[at(-600, 1650)] > 0.11, \"faster than the stream over the top (outside the separation bubble)\");\n  let wake = 0; for (let z = 450; z < 1200; z += 100) wake += t.ux[at(-1450, z)] / 8;\n  assert.ok(wake < 0.05, `slow (or reversed) air right behind the block: ${wake.toFixed(3)}`);\n  assert.ok(t.cp(at(-1250, 800)) < 0, \"suction on the back face\");\n  const d = { total: 0, push: 0, suction: 0 };\n  for (let s = 0; s < 500; s++) { t.step(); for (const k in d) d[k] += t.drag[k] / 500; }\n  assert.ok(d.push > 0 && d.suction > 0, \"the nose is pushed and the back sucked, both backwards\");\n  assert.ok(d.push + d.suction > 0.8 * d.total, `a bluff block's drag is mostly pressure: ${JSON.stringify(d)}`);\n  const cd = d.total / (0.5 * 0.1 * 0.1 * 8);   // per unit span over the 8-cell frontal height\n  assert.ok(cd > 1 && cd < 5, `2-D block (blockage raises it above ~2) drag coefficient ${cd.toFixed(2)}`);\n});\n\ntest(\"every flow config has a closed tunnel around its profile and runs stably\", async () => {\n  for (const c of await loadCars()) for (const comp of c.components.filter(k => k.params.flow))\n  for (const profile of new Set([comp.params.flow.profile, ...comp.params.shapes.map(s => s.profile).filter(Boolean)])) {\n    const F = { ...comp.params.flow, profile, ground: comp.params.ground ?? 0 }, grid = rasterize(profile, F), { nx, nz, solid } = grid;\n    assert.ok(nx * nz <= 17000, `${c.slug}: ${nx * nz} cells, over the iPhone budget`);\n    for (let i = 0; i < nx; i++) assert.equal(solid[(nz - 1) * nx + i], 0, `${c.slug}: body reaches the tunnel top`);\n    for (let j = 0; j < nz; j++) assert.equal(solid[j * nx] + solid[j * nx + nx - 1], 0, `${c.slug}: body reaches the inlet or outlet`);\n    assert.ok(solid.reduce((a, b) => a + b, 0) > 50, `${c.slug}: body has cells`);\n    const t = createTunnel(grid);\n    for (let s = 0; s < 1500; s++) t.step();\n    for (let k = 0; k < nx * nz; k++) assert.ok(Number.isFinite(t.ux[k]) && Math.abs(t.rho[k] - 1) < 0.2, `${c.slug}: unstable at cell ${k}`);\n  }\n});\n","numLines":473,"startLine":1,"totalLines":473}},"sourceToolAssistantUUID":"aae2f28b-f190-4284-96e1-362ecd2784f6","permissionDecision":{"decision":"accept","source":"config","reasonType":"other"},"session_id":"e01a3517-ccd0-4282-af04-8d07c795c5fc","userType":"external","entrypoint":"cli","cwd":"/Users/kunabel/workspace/MercedesExperience","sessionId":"5216a6b1-4da7-448e-be48-b0eb888aff5f","version":"2.1.332","gitBranch":"main","dataFlowOn":true}
